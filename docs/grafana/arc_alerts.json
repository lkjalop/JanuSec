{
  "dashboard": {
    "annotations": {},
    "panels": [],
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  },
  "alerts": [
    {
      "name": "ARC Queue Depth High",
      "expr": "increase(arc_verify_queue_depth[5m]) > 100",
      "for": "5m",
      "labels": {"severity": "critical"},
      "annotations": {"summary": "ARC verification queue growing", "description": "ARC verification queue depth increased rapidly"}
    },
    {
      "name": "ARC Verify Latency High",
      "expr": "histogram_quantile(0.95, sum(rate(arc_verify_latency_seconds_bucket[5m])) by (le)) > 5",
      "for": "10m",
      "labels": {"severity": "warning"},
      "annotations": {"summary": "ARC verification latency high", "description": "95th percentile latency for ARC verification > 5s"}
    },
    {
      "name": "ARC DNS Cache Miss Spike",
      "expr": "increase(arc_dns_cache_misses[5m]) > 500",
      "for": "10m",
      "labels": {"severity": "warning"},
      "annotations": {"summary": "ARC DNS misses spike", "description": "DNS miss rate for ARC selectors is high"}
    }
  ]
}
