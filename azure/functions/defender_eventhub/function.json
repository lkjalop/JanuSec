{
  "scriptFile": "__init__.py",
  "bindings": [
    {
      "type": "eventHubTrigger",
      "name": "events",
      "direction": "in",
      "eventHubName": "${EVENTHUB_NAME}",
      "connection": "EVENTHUB_CONNECTION",
