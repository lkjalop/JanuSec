      },
      {
        "type": "timeseries",
        "title": "IAM Feedback (by verdict)",
        "targets": [
          {"expr": "sum by (tenant, verdict)(increase(iam_feedback_total[1h]))", "refId": "B"}
        ],
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
      }
    ]
  },
  "overwrite": false
}
