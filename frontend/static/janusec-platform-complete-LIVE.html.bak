        // Action buttons and alert click details
        async function createIncidentFromRecent() {
            try {
                if (window.JanuSecModal) {
                    const ok = await JanuSecModal.confirm({
                        title: 'Create Incident',
                        message: 'Create a new incident from the most recent decision?'
                    });
                    if (!ok) { return; }
                }
                const r = await fetch('/api/v1/decisions/recent?limit=1', { headers: authHeaders() });
                const j = r.ok ? await r.json() : null;
                const row = j && (j.rows && j.rows[0] || j.events && j.events[0]);
                const eventId = row ? (row.event_id || row.id) : 'manual';
                const payload = { artifact_id: eventId, title: 'Investigation - escalated from console', severity: 'high' };
                try{
                    const cr = await fetch('/api/v1/incidents', { method:'POST', headers: { 'Content-Type':'application/json', ...authHeaders() }, body: JSON.stringify(payload) });
                    let cj = {};
                    try{ cj = await cr.json().catch(()=>({})); }catch(_){ }
                    if (!cr.ok) {
                        const det = (cj && (cj.detail || cj.error)) ? (cj.detail || cj.error) : ('HTTP ' + cr.status);
                        showNotification('Incident create failed: ' + det, 'error');
                    } else {
                        showNotification('Incident created: ' + (cj.incident && cj.incident.id || ''), 'success');
                    }
                }catch(e){ showNotification('Incident create failed: ' + (e.message || e), 'error'); }
            } catch (e) {
                showNotification('Incident create failed: ' + (e.message || e), 'error');
            }
        }
        function exportInvestigationReport() {
            // Prefer using recent tabular session ids (set by CSV Analyzer or other upload flows)
            try {
                let sess = null;
                try { sess = localStorage.getItem('lastTabularSessions'); } catch(_){ sess = null; }
                const qsBase = 'format=html&include_model=true&include_scenarios=true';
                if (sess) {
                    const arr = JSON.parse(sess);
                    if (Array.isArray(arr) && arr.length) {
                        const q = `${qsBase}&sessions=${encodeURIComponent(arr.join(','))}`;
                        window.open(`/api/v1/report/ingestion?${q}`, '_blank');
                        return;
                    }
                }
            } catch(_) {}
            // Fallback: open global report
            window.open('/api/v1/report/ingestion?format=html&include_model=true&include_scenarios=true', '_blank');
        }
        // Demo dispatch to chat integrations via webhook test
        function sendToSiem() {
            try {
                if (window.JanuSecModal) {
                    JanuSecModal.confirm({
                        title: 'Send to SIEM',
                        message: 'Dispatch a webhook test to Slack/Teams?'
                    }).then((ok) => { if (ok) _sendToSiemDo(); });
                    return;
