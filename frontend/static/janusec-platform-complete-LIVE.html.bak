        }
        @keyframes slideIn {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
        .modal-overlay {
        window.authHeaders = function(){ try { const key = (localStorage.getItem('apiKey') || 'devkey123'); const tenant = localStorage.getItem('tenantId'); const h = { 'x-api-key': key }; if (tenant) h['X-Tenant-ID'] = tenant; return h; } catch (_){ return { 'x-api-key': 'devkey123' }; } };
        window._htmlEsc = function(s){ try{ return String(s||'').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }catch(_){return '';} };
    </script>
    <script src="/static/js/test_helpers.js"></script>
    <script defer src="/static/js/notifications.js"></script>
    <script defer src="/static/js/modals.js"></script>
    <script defer src="/static/js/parse_tabular.js"></script>
    <script defer src="/static/js/live_console.bundle.js"></script>
    <style>
        /* =============================================
           JANUSEC LIVE CONSOLE THEME TOKENS (Dark)
           Maintain this block: all color / spacing changes centralize here.
           ============================================= */
        :root {
            /* Core Background Layers */
            --bg-primary: #0B0E14;
            --bg-secondary: #141A24;
            --bg-tertiary: #1D2531;
            --bg-hover: #222C39;
            --bg-elevated: #202A37;

            /* Borders & Outlines */
            --border: #2C3746;
            --border-soft: #1B222C;
            --focus-ring: #4A90E7;

            /* Text Roles */
            --text-primary: #E8EBF0;
            --text-secondary: #C2CBD6;
            --text-muted: #93A0B1;
            --text-inverse: #0B0E14;

            /* Accent & Interactive */
            --accent: #4A63E7;
            --accent-hover: #5C74F2;
            --accent-subtle: #233155;
            --accent-gradient: linear-gradient(135deg,#4A63E7,#6D5CF2 60%);

            /* Semantic / Severity */
            --critical: #E54848;
            --high: #FF8A3C;
            --medium: #E0C446;
            --low: #3FA860;
            --safe: #2DB67C;
            --info: #4DA6FF;

            /* Charts / Data Viz */
            --viz-1: #4A63E7;
            --viz-2: #FF8A3C;
            --viz-3: #3FA860;
            --viz-4: #C779D0;
            --viz-5: #4DA6FF;

            /* Shadows */
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.25);
            --shadow-md: 0 4px 12px rgba(0,0,0,0.35);

            /* Radii & Spacing Scale (4/8 rhythm) */
            --radius-xs: 3px; --radius-sm: 4px; --radius: 6px; --radius-lg: 10px;
            --space-1: 4px; --space-2: 8px; --space-3: 12px; --space-4: 16px; --space-5: 20px; --space-6: 24px; --space-7: 32px;
        }

        html, body.theme-dark { background: var(--bg-primary); color: var(--text-primary); font-family: Inter, "Segoe UI", system-ui, -apple-system, Arial, sans-serif; -webkit-font-smoothing: antialiased; }
        body { margin:0; }
        ::selection { background: var(--accent); color: #fff; }
        * { box-sizing: border-box; }
        *:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; border-radius: var(--radius-sm); }
        /* Scrollbar (webkit) */
        body::-webkit-scrollbar { width: 10px; }
        body::-webkit-scrollbar-track { background: var(--bg-secondary); }
        body::-webkit-scrollbar-thumb { background: var(--bg-tertiary); border:2px solid var(--bg-secondary); border-radius: 20px; }
        body::-webkit-scrollbar-thumb:hover { background: var(--bg-hover); }

        /* Button refinements */
        .btn { background: var(--bg-tertiary); border:1px solid var(--border); color: var(--text-primary); }
        .btn:hover { background: var(--bg-hover); }
        .btn-primary { background: var(--accent); border-color: var(--accent); color:#fff; }
        .btn-primary:hover { background: var(--accent-hover); }

        /* NAV ICONS -------------------------------------------------- */
        .nav-item { position: relative; }
        .nav-ico { width:18px; height:18px; flex-shrink:0; display:inline-block; background: var(--text-secondary); mask-size: contain; mask-repeat: no-repeat; mask-position: center; -webkit-mask-size: contain; -webkit-mask-repeat:no-repeat; -webkit-mask-position:center; opacity:0.85; transition:opacity .2s, background .2s; }
        .nav-item:hover .nav-ico { opacity:1; background: var(--text-primary); }
        .nav-item.active .nav-ico { background:#fff; opacity:1; }
    .ico { width:14px; height:14px; display:inline-block; vertical-align:middle; background: currentColor; mask-size:contain; mask-repeat:no-repeat; -webkit-mask-size:contain; -webkit-mask-repeat:no-repeat; margin-right:6px; opacity:0.9; }
    .btn .ico, .icon-btn .ico { margin-right:6px; }
        .link-btn { background:none; border:none; color:var(--accent); cursor:pointer; padding:0; font: inherit; }
        .link-btn:hover { text-decoration: underline; }
        /* Each icon uses a tiny path mask encoded as data URI (monochrome -> CSS color) */
        /* Gauge (dashboard) */
        .nav-ico--dashboard { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 14l4-4'/%3E%3Cpath d='M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z'/%3E%3C/svg%3E"); }
        /* Box (artifacts) */
        .nav-ico--artifacts { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 2l8 4-8 4-8-4Z'/%3E%3Cpath d='M4 6v6l8 4 8-4V6'/%3E%3Cpath d='M12 10v10'/%3E%3C/svg%3E"); }
        /* Flame (threats) */
        .nav-ico--threats { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 2s2 3 2 5a2 2 0 0 1-4 0c0-2 2-5 2-5Z'/%3E%3Cpath d='M12 8c-5 0-7 5-7 7a7 7 0 0 0 14 0c0-2-2-7-7-7Z'/%3E%3C/svg%3E"); }
        /* Network */
        .nav-ico--network { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='12' cy='12' r='4'/%3E%3Cpath d='M2 12h4m12 0h4M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48 2.83 2.83m0-14.14-2.83 2.83M7.76 16.24 4.93 19.07'/%3E%3C/svg%3E"); }
        /* Chip (endpoint) */
        .nav-ico--endpoint { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='4' y='4' width='16' height='16' rx='2'/%3E%3Cpath d='M9 4v2m6-2v2M9 18v2m6-2v2M4 9h2m-2 6h2M18 9h2m-2 6h2'/%3E%3C/svg%3E"); }
        /* Shield Check (compliance) */
        .nav-ico--compliance { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z'/%3E%3Cpath d='m9 12 2 2 4-4'/%3E%3C/svg%3E"); }
        /* Bar Chart (metrics) */
        .nav-ico--metrics { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 3v18h18'/%3E%3Crect x='7' y='8' width='3' height='7'/%3E%3Crect x='12' y='5' width='3' height='10'/%3E%3Crect x='17' y='10' width='3' height='5'/%3E%3C/svg%3E"); }
        /* Plug (integrations) */
        .nav-ico--integrations { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 22v-5'/%3E%3Cpath d='M9 8V2h6v6'/%3E%3Cpath d='M5 10h14'/%3E%3Cpath d='M7 10a5 5 0 0 0 10 0'/%3E%3C/svg%3E"); }
        /* Doc (reports) */
        .nav-ico--reports { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M14 2H6a2 2 0 0 0-2 2v16c0 1.1.9 2 2 2h12a2 2 0 0 0 2-2V8Z'/%3E%3Cpath d='M14 2v6h6'/%3E%3Cpath d='M10 13h4'/%3E%3Cpath d='M10 17h4'/%3E%3C/svg%3E"); }
        /* Beaker / Sandbox */
        .nav-ico--sandbox { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M4 3h16'/%3E%3Cpath d='M6 3v6a6 6 0 1 0 12 0V3'/%3E%3C/svg%3E"); }
        /* Radar / Intel */
        .nav-ico--intel { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='12' cy='12' r='10'/%3E%3Cpath d='M12 6v6l3 3'/%3E%3C/svg%3E"); }
        /* Gear (admin) */
        .nav-ico--admin { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z'/%3E%3Cpath d='M21.54 10.45a2 2 0 0 0-1-2.72l-1.1-.48a2 2 0 0 1-1.05-1.06l-.47-1.1a2 2 0 0 0-2.73-1l-1.09.46a2 2 0 0 1-1.5 0l-1.09-.46a2 2 0 0 0-2.73 1l-.47 1.1a2 2 0 0 1-1.05 1.06l-1.1.48a2 2 0 0 0-1 2.72l.46 1.09a2 2 0 0 1 0 1.5l-.46 1.09a2 2 0 0 0 1 2.73l1.1.47a2 2 0 0 1 1.05 1.05l.47 1.1a2 2 0 0 0 2.72 1l1.09-.46a2 2 0 0 1 1.5 0l1.09.46a2 2 0 0 0 2.73-1l.47-1.1a2 2 0 0 1 1.05-1.05l1.1-.47a2 2 0 0 0 1-2.73l-.46-1.09a2 2 0 0 1 0-1.5Z'/%3E%3C/svg%3E"); }
        /* Package (SBOM) */
        .nav-ico--sbom { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.73Z'/%3E%3Cpath d='M3.3 7L12 12l8.7-5'/%3E%3Cpath d='M12 22V12'/%3E%3C/svg%3E"); }
        /* Graph (graph explain) */
        .nav-ico--graph { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='12' cy='8' r='4'/%3E%3Cpath d='M6 20v-7a6 6 0 0 1 12 0v7'/%3E%3C/svg%3E"); }
        /* Scan (yara) */
        .nav-ico--yara { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='11' cy='11' r='8'/%3E%3Cpath d='m21 21-4.35-4.35'/%3E%3C/svg%3E"); }
        /* Globe (bgp) */
        .nav-ico--bgp { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='12' cy='12' r='10'/%3E%3Cpath d='M2 12h20'/%3E%3Cpath d='M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z'/%3E%3C/svg%3E"); }
        /* Table (CSV Analyzer) */
        .nav-ico--csv { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='3' y='3' width='18' height='18' rx='2'/%3E%3Cpath d='M3 9h18M9 21V9'/%3E%3C/svg%3E"); }
        /* Currency (finops) */
        .nav-ico--finops { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 2v20'/%3E%3Cpath d='M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'/%3E%3C/svg%3E"); }
        /* Checklist (approvals) */
        .nav-ico--approvals { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='3' y='5' width='18' height='14' rx='2'/%3E%3Cpath d='M7 9h4M7 13h4'/%3E%3Cpath d='m15 13 2 2 4-4'/%3E%3C/svg%3E"); }
        /* Briefcase (executive) */
        .nav-ico--executive { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='3' y='7' width='18' height='13' rx='2'/%3E%3Cpath d='M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2'/%3E%3Cpath d='M12 12h.01'/%3E%3C/svg%3E"); }
          /* Additional icons (batch, mitre, timeline, api, notifications, settings, ai, intel status) */
          .nav-ico--batch { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 7h18M3 12h12M3 17h6'/%3E%3C/svg%3E"); }
          .nav-ico--mitre { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='12' cy='12' r='10'/%3E%3Cpath d='M8 12h8M12 8v8'/%3E%3C/svg%3E"); }
          .nav-ico--timeline { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M4 4h3v6H4zM10.5 4h3v10h-3zM17 4h3v14h-3z'/%3E%3C/svg%3E"); }
          .nav-ico--api { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M4 9l4-4 4 4'/%3E%3Cpath d='M8 5v14'/%3E%3Cpath d='M20 15l-4 4-4-4'/%3E%3Cpath d='M16 5v14'/%3E%3C/svg%3E"); }
          .nav-ico--notifications { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 17l-2-2v-2a8 8 0 0 1 16 0v2l-2 2'/%3E%3Cpath d='M13.73 21a2 2 0 0 1-3.46 0'/%3E%3C/svg%3E"); }
          .nav-ico--settings { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='12' cy='12' r='3'/%3E%3Cpath d='M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09c0 .67.39 1.27 1 1.51a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.67 0 1.27.39 1.51 1H21a2 2 0 0 1 0 4h-.09c-.67 0-1.27.39-1.51 1Z'/%3E%3C/svg%3E"); }
          .nav-ico--ai { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M4 10a8 8 0 0 1 16 0v2a8 8 0 0 1-16 0Z'/%3E%3Cpath d='M7 15h10'/%3E%3Cpath d='M7 11h10'/%3E%3C/svg%3E"); }
          .nav-ico--intel-status { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='12' cy='12' r='10'/%3E%3Cpath d='M12 8v4l2 2'/%3E%3C/svg%3E"); }
          /* Newly added small action/integration icons */
          .ico-refresh { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M21 2v6h-6'/%3E%3Cpath d='M3 12a9 9 0 0 0 15 6.7l3-3M3 12a9 9 0 0 1 15-6.7l3 3'/%3E%3C/svg%3E"); }
          .ico-upload { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2'/%3E%3Cpath d='M12 12V3'/%3E%3Cpath d='m7 8 5-5 5 5'/%3E%3C/svg%3E"); }
          .ico-detach { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 3h7v7H3zM14 14h7v7h-7z'/%3E%3Cpath d='M21 3l-7 7M10 14l-7 7M14 10l4-4M10 14l-4 4'/%3E%3C/svg%3E"); }
          .ico-info { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='12' cy='12' r='10'/%3E%3Cpath d='M12 16v-4'/%3E%3Cpath d='M12 8h.01'/%3E%3C/svg%3E"); }
          .ico-xdr { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='3' y='4' width='7' height='7' rx='1'/%3E%3Crect x='14' y='4' width='7' height='7' rx='1'/%3E%3Crect x='14' y='15' width='7' height='7' rx='1'/%3E%3Cpath d='M5 15h6v6H5z'/%3E%3C/svg%3E"); }
          .ico-zeek { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='12' cy='12' r='4'/%3E%3Cpath d='M2 12h4m12 0h4M12 2v4m0 12v4m-7.07-7.07 2.83 2.83m8.48-8.48 2.83-2.83m0 11.31-2.83-2.83M7.76 7.76 4.93 4.93'/%3E%3C/svg%3E"); }
          .ico-slack { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M14.5 2a2.5 2.5 0 0 0 0 5h2.5V4.5A2.5 2.5 0 0 0 14.5 2ZM9.5 7H7V9.5A2.5 2.5 0 1 0 9.5 7Zm5 5a2.5 2.5 0 0 0-2.5 2.5V17h2.5a2.5 2.5 0 0 0 0-5ZM7 9.5A2.5 2.5 0 0 0 4.5 7 2.5 2.5 0 0 0 2 9.5v2.5H4.5A2.5 2.5 0 0 0 7 9.5Zm7.5-2.5H12v2.5A2.5 2.5 0 1 0 14.5 7Zm-5 5H7a2.5 2.5 0 1 0 2.5 2.5Zm5 0H17V12a2.5 2.5 0 0 0-2.5 0Z'/%3E%3C/svg%3E"); }
          .ico-teams { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linejoin='round' stroke-linecap='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='18' cy='6' r='3'/%3E%3Ccircle cx='9' cy='6' r='4'/%3E%3Cpath d='M2 21v-2a6 6 0 0 1 6-6h2a6 6 0 0 1 6 6v2'/%3E%3Cpath d='M16 11h2a4 4 0 0 1 4 4v6'/%3E%3C/svg%3E"); }
          .ico-whatsapp { mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linejoin='round' stroke-linecap='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 21l1.65-4.43A9 9 0 1 1 12 21a9 9 0 0 1-4.35-1.12L3 21Z'/%3E%3Cpath d='M16.54 11.73a4 4 0 0 1-4.27 4.27c-2.36-.24-4.9-2.78-5.14-5.14a4 4 0 0 1 4.27-4.27'/%3E%3C/svg%3E"); }
          /* Theme Diagnostics: tokens summary
              BG: primary/secondary/tertiary/hover/elevated | Text: primary/secondary/muted | Accent: accent/hover/subtle
              Severity: critical/high/medium/low/safe/info | Border: border/border-soft | Spacing: 4/8 rhythm */

        /* Active nav contrast & subtle separators */
        .nav-item.active { background: var(--accent); color:#fff; box-shadow: var(--shadow-sm); }
        .nav-item:not(.active) { color: var(--text-secondary); }
        .sidebar { background: linear-gradient(180deg,var(--bg-secondary), var(--bg-tertiary) 60%); }
        .content-header { background: var(--bg-secondary); }
        .right-panel { background: var(--bg-secondary); }
        .metric-card, .alert-feed, .chart-container { background: var(--bg-secondary); box-shadow: var(--shadow-sm); }
        .alert-item { background: var(--bg-tertiary); }
        .alert-item:hover { background: var(--bg-hover); }
        .alert-item .alert-title { color: var(--text-primary); }
        .alert-meta { color: var(--text-muted); }
        .metric-label { color: var(--text-muted); }
        .nav-title { color: var(--text-muted); }
        .icon-btn { background: var(--bg-tertiary); }
        .icon-btn:hover { background: var(--bg-hover); }
        /* End theme insertion */
        /* updateMetrics logic moved to /static/js/metrics.js */
        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        .status-dot.active {
            background: var(--safe);
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        /* Sidebar */
        .sidebar {
            background: var(--bg-secondary);
            border-right: 1px solid var(--border);
            padding: 16px;
            overflow-y: auto;
        }

        .nav-section {
            margin-bottom: 24px;
        }

        .nav-section.collapsed .nav-item[role],
        .nav-section.collapsed .nav-item { display: none; }
        .nav-section.collapsed .nav-title::after { content: 'Ã¢â€“Â¶'; transform: rotate(0deg); }
        .nav-section .nav-title::after { content: 'Ã¢â€“Â¼'; position: absolute; right: 4px; font-size: 10px; opacity: 0.6; }
        .nav-title { position: relative; cursor: pointer; }

        .nav-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-bottom: 8px;
            font-weight: 600;
        }

        .nav-item {
            padding: 10px 12px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 4px;
            font-size: 14px;
        }

        .nav-item:hover {
            background: var(--bg-hover);
        }

        .nav-item.active {
            background: var(--accent);
            color: white;
        }

        /* Accessibility focus styles */
        .nav-item:focus { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
        .nav-item:focus:not(:focus-visible) { outline: none; }
        .nav-item[aria-current="page"]::after {
            content: '';
            position: absolute;
            right: 6px; top: 50%; transform: translateY(-50%);
            width: 6px; height: 6px; background: #fff; border-radius: 50%;
            box-shadow: 0 0 0 2px var(--accent-subtle);
        }

        .nav-badge {
            margin-left: auto;
            background: var(--critical);
            color: white;
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 10px;
            font-weight: 600;
        }

        /* Main Content */
        .main-content {
            background: var(--bg-primary);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .content-header {
            background: var(--bg-secondary);
            padding: 16px 24px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 32px;
        }

        .content-title {
            font-size: 20px;
            font-weight: 600;
        }

        /* Header status horizontal row */
        .header .status-bar { display:flex; align-items:center; gap:18px; flex-wrap:wrap; }
        .header .status-item { display:flex; align-items:center; gap:6px; font-size:12px; color:var(--text-secondary); }
        .header-left { display:flex; align-items:center; gap:28px; }
        .logo { display:flex; align-items:center; gap:10px; font-weight:600; font-size:15px; }
        @media (max-width:1000px){ .header-left { flex-direction:column; align-items:flex-start; gap:8px; } }

        .action-bar {
            display: flex;
            gap: 12px;
        }

        .btn {
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid var(--border);
            background: var(--bg-tertiary);
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn:hover {
            background: var(--bg-hover);
        }

        .btn-primary {
            background: var(--accent);
            border-color: var(--accent);
            color: white;
        }

        .btn-primary:hover {
            background: var(--accent-hover);
        }

        /* Dashboard Grid */
        .dashboard-grid {
            padding: 24px;
            overflow-y: auto;
            flex: 1;
        }

        /* Three-column application layout */
        .app-container {
            display: grid;
            grid-template-columns: 240px 1fr 340px; /* sidebar | main | right panel */
            grid-template-rows: auto 1fr;
            grid-template-areas:
                'header header header'
                'sidebar main right';
            height: 100vh;
            overflow: hidden;
        }
        .header { grid-area: header; }
        .sidebar { grid-area: sidebar; display: flex; flex-direction: column; }
        .main-content { grid-area: main; }
        .right-panel { grid-area: right; }
        @media (max-width: 1400px) { .app-container { grid-template-columns: 220px 1fr 320px; } }
        @media (max-width: 1200px) { .app-container { grid-template-columns: 210px 1fr 0; grid-template-areas: 'header header header' 'sidebar main main'; } .right-panel { display:none; } }
        @media (max-width: 900px) { .app-container { grid-template-columns: 1fr; grid-template-areas: 'header' 'main'; } .sidebar { position: fixed; z-index: 9999; top:0; bottom:0; left:0; transform: translateX(-100%); width: 240px; background: var(--bg-secondary); transition: transform .3s; } .sidebar.open { transform: translateX(0); } }

        .metrics-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .metric-card {
            background: var(--bg-secondary);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid var(--border);
        }

        /* Admin tuning panel styles */
        .admin-panel { padding:12px; border-radius:6px; background:var(--bg-tertiary); border:1px solid var(--border); }
        .admin-panel label{ display:block; font-size:12px; color:var(--text-muted); margin-top:8px }
        .small-input{ width:100%; padding:8px; background:var(--bg-primary); border:1px solid var(--border); color:var(--text-primary); border-radius:6px }

        .metric-value {
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .metric-label {
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Small icon button inside alert rows */
        .icon-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            border: 1px solid var(--border);
            background: var(--bg-primary);
            color: var(--text-primary);
            border-radius: 6px;
            padding: 4px 8px;
            cursor: pointer;
            font-size: 12px;
        }
        .icon-btn:hover { background: var(--bg-hover); }

        .chart-container {
            background: var(--bg-secondary);
            border-radius: 8px;
            border: 1px solid var(--border);
            padding: 20px;
            margin-bottom: 24px;
            height: 300px;
        }

        /* Small metrics widget for demo: shows CS detection dedupe and DB upserts */
        .mini-metrics { display:flex; gap:12px; align-items:center; }
        .mini-metrics .mini-card { background: var(--bg-elevated); padding:8px 12px; border-radius:6px; border:1px solid var(--border); color:var(--text-primary); font-size:12px; }

        /* Alert Feed */
        .alert-feed {
            background: var(--bg-secondary);
            border-radius: 8px;
            border: 1px solid var(--border);
            padding: 16px;
        }

        .alert-item {
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 8px;
            background: var(--bg-tertiary);
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .alert-item:hover {
            background: var(--bg-hover);
        }

        .alert-severity {
            width: 4px;
            height: 40px;
            border-radius: 2px;
        }

        .alert-severity.critical {
            background: var(--critical);
        }

        .alert-severity.high {
            background: var(--high);
        }

        .alert-content {
            flex: 1;
        }

        .alert-title {
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 4px;
        }

        .alert-meta {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* Right Panel */
        .right-panel {
            background: var(--bg-secondary);
            border-left: 1px solid var(--border);
            padding: 20px;
            overflow-y: auto;
            position: relative;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .detach-btn {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--bg-tertiary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .detach-btn:hover {
            background: var(--bg-hover);
        }

        /* Investigation Details */
        .investigation-section {
            margin-bottom: 24px;
        }

        .section-title {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 12px;
            color: var(--text-secondary);
        }

        .evidence-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .evidence-item {
            padding: 10px;
            background: var(--bg-primary);
            border-radius: 6px;
            font-size: 13px;
            font-family: 'Monaco', 'Consolas', monospace;
        }

        /* Integration Section */
        .integration-panel {
            background: var(--bg-tertiary);
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 16px;
        }

        .integration-header {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-bottom: 12px;
        }

        .integration-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .integration-btn {
            padding: 10px;
            background: var(--bg-primary);
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .integration-btn:hover {
            background: var(--bg-hover);
            border-color: var(--accent);
        }

        .integration-btn.connected {
            border-color: var(--safe);
            background: rgba(82, 196, 26, 0.1);
        }

        /* Upload Zone */
        .upload-zone {
            border: 2px dashed var(--border);
            border-radius: 8px;
            padding: 32px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            margin-bottom: 24px;
        }

        .upload-zone:hover {
            border-color: var(--accent);
            background: var(--bg-tertiary);
        }

        .upload-zone.dragover {
            border-color: var(--accent);
            background: rgba(74, 99, 231, 0.1);
        }

        /* Modal for detached panel */
        .detached-window {
            display: none;
            position: fixed;
            top: 50px;
            right: 50px;
            width: 600px;
            height: 80vh;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 8px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            z-index: 1000;
        }

        .detached-window.active {
            display: block;
        }

        .detached-header {
            padding: 16px 20px;
            background: var(--bg-tertiary);
            border-bottom: 1px solid var(--border);
            border-radius: 8px 8px 0 0;
            cursor: move;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .detached-content {
            padding: 20px;
            height: calc(100% - 56px);
            overflow-y: auto;
        }

        /* Notification System */
        .notification {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: var(--bg-tertiary);
            border: 1px solid var(--accent);
            border-radius: 8px;
            padding: 16px;
            min-width: 300px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.55);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 10000;
        }
        .modal-dialog {
            width: 900px;
            max-width: 96vw;
            max-height: 90vh;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 30px rgba(0,0,0,0.6);
        }
        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            background: var(--bg-tertiary);
        }
        .modal-title {
            font-size: 16px;
            font-weight: 600;
        }
        .modal-body {
            padding: 14px 16px;
            overflow-y: auto;
        }
        /* Tabs */
        .tabs {
            display: flex;
            gap: 6px;
            margin: 6px 0 12px 0;
            flex-wrap: wrap;
        }
        .tab-btn { cursor: pointer; }
        .tab-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }
        .tab-section { display: none; }
        .tab-section.active { display: block; }
        .close-btn {
            border: 1px solid var(--border);
            background: var(--bg-secondary);
            color: var(--text-primary);
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
        }
        .pill {
            padding: 3px 8px;
            border-radius: 999px;
            font-size: 11px;
            background: var(--bg-primary);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            display: inline-block;
            margin: 2px 4px 2px 0;
        }
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        .sub-card {
            background: var(--bg-primary);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 10px 12px;
        }
    </style>
</head>
<body class="theme-dark">
        <!-- Synchronous hidden file input: present immediately so Playwright can wait for #fileInput attached state -->
        <input type="file" id="fileInput" style="display:none;" multiple accept=".pcap,.evtx,.json,.csv,.log,.xls,.xlsx,.xlsm,.ods,.zip,.gz">
    <div class="app-container" id="appContainer">
        <!-- Header -->
    <header class="header">
            <div class="header-left">
                <div class="logo">
                    <svg width="28" height="28" viewBox="0 0 64 64" fill="none">
                        <circle cx="32" cy="32" r="30" stroke="var(--accent)" stroke-width="2"/>
                        <path d="M32 8 L32 56" stroke="var(--accent)" stroke-width="1" opacity="0.3"/>
                        <path d="M20 24 Q20 20 24 20 L28 20 L28 44 Q28 48 24 48 L20 48 Z" fill="var(--accent)" opacity="0.8"/>
                        <path d="M44 24 Q44 20 40 20 L36 20 L36 44 Q36 48 40 48 L44 48 Z" fill="var(--accent)" opacity="0.8"/>
                    </svg>
                    JanuSec Platform
                </div>
                <div class="status-bar">
                    <div class="status-item">
                        <div class="status-dot active"></div>
                        <span>Connected to XDR</span>
                    </div>
                    <div class="status-item">
                        <span style="color: var(--text-muted);">Last Update:</span>
                        <span id="lastUpdate">2 min ago</span>
                    </div>
                </div>
                                            <script>
                                                // Ensure #fileInput remains attached: if other scripts replace uploadZone, re-attach our hidden input to body
                                                (function(){ try{ const ensure = ()=>{ try{ if(!document.getElementById('fileInput')){ const inp=document.createElement('input'); inp.type='file'; inp.id='fileInput'; inp.style.display='none'; inp.multiple=true; inp.accept='.pcap,.evtx,.json,.csv,.log,.xls,.xlsx,.xlsm,.ods,.zip,.gz'; document.body.appendChild(inp); } else { const el=document.getElementById('fileInput'); if(el && !el.closest('body') && document.body) document.body.appendChild(el); } }catch(e){} }; ensure(); const mo = new MutationObserver(()=> ensure()); mo.observe(document.documentElement || document.body, { childList:true, subtree:true }); setTimeout(()=> mo.disconnect(), 20000); }catch(e){ console.warn('fileInput observer failed', e); } })();
                                            </script>
                <div class="mini-metrics" id="miniMetricsHeader" style="margin-left:18px;">
                    <div class="mini-card">CS dedupe: <span id="cs_dedupe_val">-</span></div>
                    <div class="mini-card">CS db upserts: <span id="cs_upsert_val">-</span></div>
                </div>
            </div>
            <div class="status-bar">
                <div class="status-item">
                    <span style="color: var(--critical);">ÃƒÂ¢Ã¢â‚¬â€Ã‚Â</span>
                    Critical: <strong id="criticalCount">2</strong>
                </div>
                <div class="status-item">
                    <span style="color: var(--high);">ÃƒÂ¢Ã¢â‚¬â€Ã‚Â</span>
                    High: <strong id="highCount">8</strong>
                </div>
                <div class="status-item">
                    <span style="color: var(--medium);">ÃƒÂ¢Ã¢â‚¬â€Ã‚Â</span>
                    Medium: <strong id="mediumCount">15</strong>
                </div>
                <div class="status-item" title="AI provider status">
                    <span id="aiStatus" class="pill-badge pill-warn">AI: n/a</span>
                </div>
                <div class="status-item" title="FinOps anomaly status">
                    <span id="finopsStatus" class="pill-badge pill-warn">FinOps: n/a</span>
                </div>
            </div>
        </header>

        <!-- Sidebar (normalized) -->
    <nav class="sidebar" role="navigation" aria-label="Primary">
            <div class="nav-section">
                <div class="nav-title">Detection & Response</div>
                <div class="nav-item active" role="link" tabindex="0" data-view="dashboard" aria-current="page"><span class="nav-ico nav-ico--dashboard"></span>Dashboard</div>
                <div class="nav-item" role="link" tabindex="0" data-view="artifacts"><span class="nav-ico nav-ico--artifacts"></span>Artifacts<span class="nav-badge" id="artifactsCount">342</span></div>
                <div class="nav-item" role="link" tabindex="0" data-view="threats"><span class="nav-ico nav-ico--threats"></span>Active Threats<span class="nav-badge" id="threatCount">2</span></div>
            </div>
            <div class="nav-section">
