        async function submitOverride(eventId) {
            try {
                if (window.JanuSecModal) {
                    const ok = await JanuSecModal.confirm({
                        title: 'Override Decision',
                        message: `Apply a manual override to decision ${eventId}?`,
                        icon: 'warning',
                        confirmText: 'Apply Override'
                    });
                    if (!ok) return;
                }
                const verdict = (document.getElementById('ovVerdict') || {}).value;
                const confRaw = (document.getElementById('ovConfidence') || {}).value;
                const reason = (document.getElementById('ovReason') || {}).value || undefined;
                const confidence = confRaw ? parseFloat(confRaw) : undefined;
                try{
                    const r = await fetch(`/api/v1/decisions/${eventId}/override`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json', ...authHeaders() },
                        body: JSON.stringify({ verdict, confidence, reason })
                    });
                    let j = {};
                    try{ j = await r.json().catch(() => ({})); }catch(_){}
                    if (!r.ok) {
                        const det = (j && (j.detail || j.error)) ? (j.detail || j.error) : ('HTTP ' + r.status);
                        showNotification('Override failed: ' + det, 'error');
                        return;
                    }
                    showNotification('Override applied', 'success');
                    const jr = j || {};
                    const badge = document.getElementById('invVerdictPill');
                    if (badge) badge.textContent = `Verdict: ${jr.verdict || verdict} (${jr.confidence ?? confidence ?? '-'})`;
                }catch(e){ showNotification('Override failed: ' + (e.message || e), 'error'); }
            } catch (e) {
                showNotification('Override failed: ' + (e.message || e), 'error');
            }
        }
        
        // KEV status utilities
        async function loadKevStatus(){
            try{
                const r = await fetch('/api/v1/compliance/kev/status', { headers: { ...authHeaders() } });
                if(!r.ok) return;
                const j = await r.json();
                const kc = document.getElementById('kevCount');
                const ka = document.getElementById('kevAge');
                if(kc) kc.textContent = String(j.kev_cached ?? '0');
                if(ka){
                    const s = j.kev_age_seconds;
                    if(typeof s === 'number'){
                        const mins = Math.floor(s/60);
                        ka.textContent = mins>0? (mins+" min") : (s+" s");
                    } else { ka.textContent = 'Ã¢â‚¬â€'; }
                }
            }catch(e){ /* non-fatal */ }
        }
        async function refreshKev(){
            try{
                const r = await fetch('/api/v1/compliance/kev/refresh', { method:'POST', headers: { ...authHeaders() } });
                let ok = false;
                try{ const j = await r.json(); ok = !!(r.ok && (j.ok!==false)); }catch(_){ ok = r.ok; }
                showNotification(ok? 'KEV/EPSS refresh triggered' : 'KEV/EPSS refresh failed', ok? 'success':'error');
                setTimeout(loadKevStatus, 1000);
            }catch(e){ showNotification('KEV/EPSS refresh error','error'); }
        }

