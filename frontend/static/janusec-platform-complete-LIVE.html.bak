        // Initialize with REAL API connections
    async function initializePlatform() {
            showNotification('JanuSec Platform connecting to backend...', 'info');

            try {
                // Test backend connection
    const healthResponse = await fetch('/health', { headers: { ...authHeaders() } });
                if (!healthResponse.ok) {
                    if (healthResponse.status === 401 || healthResponse.status === 403) {
                        showAuthBanner({ message: 'Unauthorized (401/403) Ã¢â‚¬â€ your API key is missing or invalid.' });
                        throw new Error('Unauthorized');
                    }
                    throw new Error('Backend not available');
                }

                // Load initial data
                await updateMetrics();
                // Load KEV status and wire actions
                try{ loadKevStatus(); const kr = document.getElementById('btnKevRefresh'); if(kr) kr.addEventListener('click', refreshKev); }catch(_){ }

                // Set up auto-refresh every 30 seconds
                setInterval(updateMetrics, 30000);

                showNotification('JanuSec Platform initialized successfully - all systems connected!', 'success');
            } catch (error) {
                console.error('Backend connection failed:', error);
                // If network or auth issue, surface persistent banner with actions
                showAuthBanner({ message: (error && String(error)) || 'Backend connection failed - running in demo mode' });
                showNotification('Backend connection failed - running in demo mode', 'error');

                // Fallback to demo mode
                updateMetrics();
            }
        }

        // NLP Query Panel
        function renderNlpPanel() {
            const rp = document.getElementById('rightPanel');
            const panel = document.createElement('div');
            panel.className = 'investigation-section';
            panel.innerHTML = `
                <div class="section-title">NLP Query</div>
                <div style="display:flex; gap:8px; margin-bottom:8px;">
                    <input id="nlpInput" class="chain-input" placeholder="Ask e.g., 'metrics', 'alerts', 'recent decisions'" style="flex:1;" />
                    <button class="btn" id="nlpBtn">Query</button>
                </div>
                <div class="evidence-item" id="nlpOut">Try asking for metrics or alerts.</div>
            `;
            rp.insertBefore(panel, rp.firstChild);
            document.getElementById('nlpBtn').addEventListener('click', async () => {
                const q = document.getElementById('nlpInput').value || '';
                try {
                    const r = await fetch('/api/v1/query/nlp', { method: 'POST', headers: { 'Content-Type': 'application/json', ...authHeaders() }, body: JSON.stringify({ text: q }) });
                    const j = await r.json();
                    const actions = (j.actions || []).map(a => `${a.method} ${a.path} - ${a.title}`).join('\n');
                    document.getElementById('nlpOut').textContent = `Intent: ${j.intent}\n${actions}`;
                } catch (e) {
                    document.getElementById('nlpOut').textContent = 'NLP query failed: ' + e.message;
                }
            });
        }

    // Start initialization when page loads
        function _boot() { try { if (typeof renderNlpPanel === 'function') { try{ renderNlpPanel(); }catch(e){ console.warn('renderNlpPanel failed', e); } } else { console.debug('renderNlpPanel not defined; skipping'); } initializePlatform(); if (typeof attachActionHandlers === 'function') { try{ attachActionHandlers(); }catch(e){ console.warn('attachActionHandlers failed', e); } } else { console.debug('attachActionHandlers not defined; skipping'); } } catch(e) { console.error('init failed', e); } }
        if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', _boot); } else { _boot(); }
        // Extracted scripts are loaded statically below
        // Accessibility & keyboard navigation for sidebar (idempotent)
        (function(){
            const sidebar = document.querySelector('.sidebar');
            if(!sidebar) return;
            const items = Array.from(sidebar.querySelectorAll('.nav-item'));
            function setActive(el){
                items.forEach(i=>{ i.classList.remove('active'); i.removeAttribute('aria-current'); });
                el.classList.add('active');
                el.setAttribute('aria-current','page');
            }
            // Accordion collapse logic
            const sections = Array.from(sidebar.querySelectorAll('.nav-section'));
            sections.forEach(sec => {
                const title = sec.querySelector('.nav-title');
                if(!title) return;
                title.setAttribute('role','button');
                title.setAttribute('tabindex','0');
                title.addEventListener('click', ()=>{ sec.classList.toggle('collapsed'); });
                title.addEventListener('keydown', (e)=>{ if(e.key==='Enter' || e.key===' '){ e.preventDefault(); sec.classList.toggle('collapsed'); } });
            });
            // Auto-collapse if viewport height small
            function autoCollapse(){
                if(window.innerHeight < 800){
                    sections.slice(1).forEach(s=>s.classList.add('collapsed'));
                }
            }
            autoCollapse();
            window.addEventListener('resize', autoCollapse);
            sidebar.addEventListener('click', (e)=>{
                const item = e.target.closest('.nav-item');
                if(!item) return;
                if(item.dataset.view){ e.preventDefault(); setActive(item); switchView(item.dataset.view, item); }
                if(item.dataset.window){ e.preventDefault(); window.open(item.dataset.window,'_blank'); }
            });
            sidebar.addEventListener('keydown', (e)=>{
                const current = document.activeElement.closest('.nav-item');
                const idx = items.indexOf(current);
                if(e.key === 'ArrowDown'){ e.preventDefault(); items[(idx+1+items.length)%items.length].focus(); }
                else if(e.key === 'ArrowUp'){ e.preventDefault(); items[(idx-1+items.length)%items.length].focus(); }
                else if(e.key === 'Home'){ e.preventDefault(); items[0].focus(); }
                else if(e.key === 'End'){ e.preventDefault(); items[items.length-1].focus(); }
                else if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); current && current.click(); }
            });
        })();
    </script>
            <script>
            // Mini metrics updater for CS metrics in header
            (function(){
                function parsePrometheusMetrics(text){
                    const lines = text.split('\n');
                    const metrics = {};
                    for(const l of lines){
                        if(!l || l.startsWith('#')) continue;
                        const parts = l.trim().split(/\s+/);
                        if(parts.length<2) continue;
                        const name = parts[0];
                        const val = parseFloat(parts[1]);
                        metrics[name] = (metrics[name] || 0) + (isNaN(val)?0:val);
                    }
                    return metrics;
                }
