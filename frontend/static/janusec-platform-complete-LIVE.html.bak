        function _sendToSiemDo(){
            try {
                const service = 'slack';
                fetch('/api/v1/webhooks/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', ...authHeaders() },
                    body: JSON.stringify({ service })
                }).then(async (r) => {
                    let j = {};
                    try { j = await r.json().catch(()=>({})); } catch(_) { j = {}; }
                    if (r.ok && j && j.delivered) {
                        showNotification(`${service} webhook test delivered`, 'success');
                    } else if (r.ok && j && j.error === 'no_webhook_configured') {
                        showNotification(`${service} webhook not configured`, 'error');
                    } else {
                        const det = (j && (j.detail || j.error)) ? (j.detail || j.error) : ('HTTP ' + r.status);
                        showNotification('Dispatch failed: ' + det, 'error');
                    }
                }).catch((e) => {
                    showNotification('Dispatch failed: ' + (e && e.message || e), 'error');
                });
            } catch(e) {
                showNotification('Dispatch failed: ' + (e && e.message || e), 'error');
            }
        }
