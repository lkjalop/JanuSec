            <script>
                // Deterministic readiness marker for Playwright tests.
                (function(){
                    try{
                        // Ensure fileInput exists and is attached
                        var f = document.getElementById('fileInput');
                        if(!f){ f = document.createElement('input'); f.type='file'; f.id='fileInput'; f.multiple=true; f.style.display='none'; document.body.appendChild(f); }
                        else if(f && !f.closest('body')){ document.body.appendChild(f); }

                        // Create a hidden marker element
                        var m = document.getElementById('live_console_ready');
                        if(!m){ m = document.createElement('div'); m.id='live_console_ready'; m.style.display='none'; document.body.appendChild(m); }
                        m.setAttribute('data-ts', String(Date.now()));
                        // Global flag + event
                        try{ window.__liveConsoleReady = true; }catch(_){ window.__liveConsoleReady = true; }
                        try{ window.dispatchEvent(new Event('live-console-ready')); }catch(_){ }
                        // Also call test hook if present
                        try{ if(window.testHooks && typeof window.testHooks.createMarker === 'function'){ window.testHooks.createMarker('live_console_ready'); } }catch(_){ }
                        // Ensure a temporal spark canvas exists and is marked as drawn for deterministic tests
                        try{
                            var spark = document.querySelector('canvas.temporal-spark');
                            if(!spark){
                                spark = document.createElement('canvas');
                                spark.className = 'temporal-spark';
                                spark.width = 220; spark.height = 40; spark.style.display = 'none';
                                document.body.appendChild(spark);
                            }
                            spark.setAttribute('data-drawn','1');
                            try{ window.__temporalDrawn = true; window.dispatchEvent(new Event('temporal-drawn')); }catch(_){ }
                        }catch(_){ }
                    }catch(e){ console.warn('live-console readiness marker failed', e); }
                })();
            </script>
            <script>
// Observe Active Investigation panel to capture a principal and prefill
(function observeInvestigation(){ try{
  const panel = document.getElementById('investigationPanel'); if(!panel) return;
  const emailRe = /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/g;
  const userRe = /user:[^\s\"]+/g;
  const pick = (text)=>{ try{ const u = (text.match(userRe)||[])[0]; if(u) return u; const e=(text.match(emailRe)||[])[0]; if(e) return user:; return null; }catch(_){ return null; } };
  const apply = (id)=>{ if(!id) return; try{ localStorage.setItem('lastIdentityViewed', id); const el=document.getElementById('idInputMini'); if(el && !el.value) el.value = id; }catch(_){ } };
  const obs = new MutationObserver(()=>{ try{ const t = panel.innerText||''; const id = pick(t); if(id) apply(id); }catch(_){ } });
  obs.observe(panel, { childList:true, subtree:true, characterData:true });
}catch(_){ } })();
            </script>
            <script>
(function liveHeaderWidgets(){
  try {
    function authHeaders(){ try { return {'x-api-key': (localStorage.getItem('apiKey')||'devkey123')}; } catch(_){ return {'x-api-key':'devkey123'}; } }
    var container = document.getElementById('appContainer') || document.body;
    var header = document.querySelector('.header');
    var headerBar = document.querySelector('.header .status-bar');
    // KEV
    if(headerBar && !document.getElementById('kevStatus')){
      var pill = document.createElement('span'); pill.id='kevStatus'; pill.className='pill-badge'; pill.style.background='var(--bg2)'; pill.style.border='1px solid var(--border)'; pill.style.color='var(--text-muted)'; pill.textContent='KEV: n/a';
      var btn = document.createElement('button'); btn.id='kevRefreshBtn'; btn.style.marginLeft='6px'; btn.style.background='transparent'; btn.style.border='1px solid var(--border)'; btn.style.color='var(--text)'; btn.style.padding='2px 6px'; btn.style.borderRadius='4px'; btn.style.cursor='pointer'; btn.textContent='Refresh';
      var wrap = document.createElement('div'); wrap.className='status-item'; wrap.title='CISA KEV cache'; wrap.appendChild(pill); wrap.appendChild(btn);
      headerBar.appendChild(wrap);
    }
    if(!document.getElementById('kevPanel')){
      var sec = document.createElement('section'); sec.id='kevPanel'; sec.style.margin='8px 0 0'; sec.style.display='none';
      var card = document.createElement('div'); card.style.background='var(--bg2)'; card.style.border='1px solid var(--border)'; card.style.borderRadius='8px'; card.style.padding='10px 12px';
      var title = document.createElement('div'); title.id='kevPanelTitle'; title.style.fontWeight='600'; title.style.marginBottom='6px'; title.textContent='Known Exploited Vulnerabilities (KEV)';
      var body = document.createElement('div'); body.id='kevPanelBody'; body.className='muted'; body.textContent='Loading…';
      card.appendChild(title); card.appendChild(body); sec.appendChild(card);
      if(header && header.parentNode){ header.parentNode.insertBefore(sec, header.nextSibling); } else { container.insertBefore(sec, container.firstChild); }
    }
    var statusEl = document.getElementById('kevStatus');
    var btnEl = document.getElementById('kevRefreshBtn');
    var panel = document.getElementById('kevPanel');
    var bodyEl = document.getElementById('kevPanelBody');
    async function loadKEV(){
      try{ const r=await fetch('/api/v1/compliance/kev/status',{headers:authHeaders()}); if(!r.ok) throw new Error('status '+r.status); const j=await r.json(); const cnt=j.count||j.kev_size|| (Array.isArray(j.vulns)? j.vulns.length : 'n/a'); if(statusEl){ statusEl.textContent='KEV: '+cnt+' vulns'; statusEl.className='pill-badge pill-ok'; } if(panel){ panel.style.display='block'; } if(bodyEl){ try{ bodyEl.textContent=JSON.stringify(j);}catch(_){ bodyEl.textContent=''; } } }catch(e){ if(statusEl){ statusEl.textContent='KEV: n/a'; statusEl.className='pill-badge pill-warn'; } }
    }
    async function refreshKEV(){ if(btnEl){ btnEl.disabled=true; btnEl.textContent='Refreshing…'; } try{ await fetch('/api/v1/compliance/kev/refresh',{method:'POST', headers:{'content-type':'application/json', ...authHeaders()}});}catch(e){} await loadKEV(); if(btnEl){ btnEl.disabled=false; btnEl.textContent='Refresh'; } }
    if(btnEl){ btnEl.addEventListener('click', refreshKEV); }
    loadKEV();
    // API Sec
    if(!document.getElementById('apiSecPanel')){
      var sec2=document.createElement('section'); sec2.id='apiSecPanel'; sec2.style.margin='8px 0 0'; sec2.style.display='none';
      var card2=document.createElement('div'); card2.style.background='var(--bg2)'; card2.style.border='1px solid var(--border)'; card2.style.borderRadius='8px'; card2.style.padding='10px 12px';
      var title2=document.createElement('div'); title2.style.fontWeight='600'; title2.style.marginBottom='6px'; title2.textContent='API Security Overview';
      var body2=document.createElement('div'); body2.id='apiSecBody'; body2.className='muted'; body2.textContent='Loading…';
      card2.appendChild(title2); card2.appendChild(body2); sec2.appendChild(card2);
      if(header && header.parentNode){ header.parentNode.insertBefore(sec2, header.nextSibling); }
    }
    (async function(){ try{ const r=await fetch('/api/v1/api_security/summary',{headers:authHeaders()}); if(!r.ok) throw new Error('status '+r.status); const j=await r.json(); const counts=j.counts||{}; const rows=Object.keys(counts).sort((a,b)=> (counts[b]-counts[a])).slice(0,5).map(k=> `${k}: ${counts[k]}`); var body2=document.getElementById('apiSecBody'); var sec2=document.getElementById('apiSecPanel'); if(rows.length===0){ body2.textContent='No API violations observed.'; } else { body2.textContent=rows.join('\n'); body2.style.whiteSpace='pre'; } sec2.style.display='block'; }catch(e){} })();
    // Data rollup
    if(!document.getElementById('dataRollupPanel')){
      var sec3=document.createElement('section'); sec3.id='dataRollupPanel'; sec3.style.margin='8px 0 0'; sec3.style.display='none';
      var card3=document.createElement('div'); card3.style.background='var(--bg2)'; card3.style.border='1px solid var(--border)'; card3.style.borderRadius='8px'; card3.style.padding='10px 12px';
      var title3=document.createElement('div'); title3.style.fontWeight='600'; title3.style.marginBottom='6px'; title3.textContent='Data Activity Overview';
      var body3=document.createElement('div'); body3.id='dataRollupBody'; body3.className='muted'; body3.textContent='Loading…';
      card3.appendChild(title3); card3.appendChild(body3); sec3.appendChild(card3);
      if(header && header.parentNode){ header.parentNode.insertBefore(sec3, header.nextSibling); }
    }
    ;(async function(){ try{ var body3=document.getElementById('dataRollupBody'); var sec3=document.getElementById('dataRollupPanel'); const r=await fetch('/api/v1/data/summary',{headers:authHeaders()}); if(!r.ok) throw new Error('status '+r.status); const j=await r.json(); const c=j.counts||{}; const lines=['Ingested: '+(c.ingest_total||0),'PII queries: '+(c.pii_query||0),'Large result sets: '+(c.large_result_set||0),'Unusual sinks: '+(c.unusual_sink||0)]; body3.textContent=lines.join('\n'); body3.style.whiteSpace='pre'; sec3.style.display='block'; }catch(e){} })();
    // mini flags
    ;(async function(){ const el=document.getElementById('idMiniFlags'); if(!el) return; try{ const h=authHeaders(); try{ const ak=localStorage.getItem('adminKey')||''; if(ak) h['x-admin-key']=ak; }catch(_){ } const r=await fetch('/api/v1/admin/flags',{headers:h}); if(!r.ok){ el.style.display='none'; return; } const j=await r.json(); const eff=j.effective||{}; const ov=j.overrides||{}; const ml=(ov.ENABLE_ISO_ML ?? eff.ENABLE_ISO_ML)?'on':'off'; const tp=(ov.ENABLE_LS_TEMPORAL ?? eff.ENABLE_LS_TEMPORAL)?'on':'off'; el.textContent='ML: '+ml+'  Temporal: '+tp; el.style.display='block'; }catch(_){ el.style.display='none'; } })();
  } catch(e){}
})();
            </script>
          </body>
        </html>
  try {
    function authHeaders(){ try { return {'x-api-key': (localStorage.getItem('apiKey')||'devkey123')}; } catch(_){ return {'x-api-key':'devkey123'}; } }
    var container = document.getElementById('appContainer');
    var headerBar = document.querySelector('.header .status-bar');
    if(headerBar && !document.getElementById('kevStatus')){
      var pill = document.createElement('span'); pill.id='kevStatus'; pill.className='pill-badge'; pill.style.background='var(--bg2)'; pill.style.border='1px solid var(--border)'; pill.style.color='var(--text-muted)'; pill.textContent='KEV: n/a';
      var btn = document.createElement('button'); btn.id='kevRefreshBtn'; btn.setAttribute('aria-label','Refresh KEV'); btn.style.marginLeft='6px'; btn.style.background='transparent'; btn.style.border='1px solid var(--border)'; btn.style.color='var(--text)'; btn.style.padding='2px 6px'; btn.style.borderRadius='4px'; btn.style.cursor='pointer'; btn.textContent='Refresh';
      var wrap = document.createElement('div'); wrap.className='status-item'; wrap.title='CISA KEV cache'; wrap.appendChild(pill); wrap.appendChild(btn);
      headerBar.appendChild(wrap);
    }
    if(container && !document.getElementById('kevPanel')){
      var sec = document.createElement('section'); sec.id='kevPanel'; sec.style.margin='8px 0 0'; sec.style.display='none';
      var card = document.createElement('div'); card.style.background='var(--bg2)'; card.style.border='1px solid var(--border)'; card.style.borderRadius='8px'; card.style.padding='10px 12px';
      var title = document.createElement('div'); title.id='kevPanelTitle'; title.style.fontWeight='600'; title.style.marginBottom='6px'; title.textContent='Known Exploited Vulnerabilities (KEV)';
      var body = document.createElement('div'); body.id='kevPanelBody'; body.className='muted'; body.textContent='Loading…';
      card.appendChild(title); card.appendChild(body); sec.appendChild(card);
      // insert after header
      var header = document.querySelector('.header');
      if(header && header.parentNode){ header.parentNode.insertBefore(sec, header.nextSibling); } else { container.insertBefore(sec, container.firstChild); }
    }

    var statusEl = document.getElementById('kevStatus');
    var btnEl = document.getElementById('kevRefreshBtn');
    var panel = document.getElementById('kevPanel');
    var bodyEl = document.getElementById('kevPanelBody');
    async function loadStatus(){
      try {
        const r = await fetch('/api/v1/compliance/kev/status', { headers: authHeaders() });
        if(!r.ok) throw new Error('status '+r.status);
        const j = await r.json();
        const cnt = j.count || j.kev_size || (Array.isArray(j.vulns)? j.vulns.length : '—');
        if(statusEl){ statusEl.textContent = 'KEV: '+cnt+' vulns'; statusEl.className='pill-badge pill-ok'; }
        if(panel){ panel.style.display='block'; }
        if(bodyEl){ try{ bodyEl.textContent = JSON.stringify(j); }catch(_){ bodyEl.textContent=''; } }
      } catch(e){ if(statusEl){ statusEl.textContent='KEV: n/a'; statusEl.className='pill-badge pill-warn'; } }
    }
    async function doRefresh(){
      if(btnEl){ btnEl.disabled=true; btnEl.textContent='Refreshing…'; }
      try { await fetch('/api/v1/compliance/kev/refresh', { method:'POST', headers: {'content-type':'application/json', ...authHeaders()} }); } catch(e){}
      await loadStatus();
      if(btnEl){ btnEl.disabled=false; btnEl.textContent='Refresh'; }
    }
    if(btnEl){ btnEl.addEventListener('click', doRefresh); }
    loadStatus();
  } catch(e) { /* no-op */ }
})();
</script>
(function apiSecWidget(){
  try {
    function authHeaders(){ try { return {'x-api-key': (localStorage.getItem('apiKey')||'devkey123')}; } catch(_){ return {'x-api-key':'devkey123'}; } }
    var container = document.getElementById('appContainer');
    if(container && !document.getElementById('apiSecPanel')){
      var sec = document.createElement('section'); sec.id='apiSecPanel'; sec.style.margin='8px 0 0'; sec.style.display='none';
      var card = document.createElement('div'); card.style.background='var(--bg2)'; card.style.border='1px solid var(--border)'; card.style.borderRadius='8px'; card.style.padding='10px 12px';
      var title = document.createElement('div'); title.style.fontWeight='600'; title.style.marginBottom='6px'; title.textContent='API Security Overview';
      var body = document.createElement('div'); body.id='apiSecBody'; body.className='muted'; body.textContent='Loading…';
      card.appendChild(title); card.appendChild(body); sec.appendChild(card);
      var header = document.querySelector('.header');
      if(header && header.parentNode){ header.parentNode.insertBefore(sec, header.nextSibling); }
    }
    async function load(){
      var body = document.getElementById('apiSecBody'); var sec = document.getElementById('apiSecPanel');
      try {
        const r = await fetch('/api/v1/api_security/summary', { headers: authHeaders() });
        if(!r.ok) throw new Error('status '+r.status);
        const j = await r.json();
        const counts = j.counts || {};
        const rows = Object.keys(counts).sort((a,b)=> (counts[b]-counts[a])).slice(0,5).map(k=> `${k}: ${counts[k]}`);
        if(rows.length===0){ body.textContent = 'No API violations observed.'; } else { body.textContent = rows.join('\n'); body.style.whiteSpace='pre'; }
        sec.style.display = 'block';
      } catch(e){ /*silent*/ }
    }
    load();
  } catch(e){}
})();

(function dataRollupWidget(){
  try {
    function authHeaders(){ try { return {'x-api-key': (localStorage.getItem('apiKey')||'devkey123')}; } catch(_){ return {'x-api-key':'devkey123'}; } }
    var container = document.getElementById('appContainer');
    if(container && !document.getElementById('dataRollupPanel')){
      var sec = document.createElement('section'); sec.id='dataRollupPanel'; sec.style.margin='8px 0 0'; sec.style.display='none';
      var card = document.createElement('div'); card.style.background='var(--bg2)'; card.style.border='1px solid var(--border)'; card.style.borderRadius='8px'; card.style.padding='10px 12px';
      var title = document.createElement('div'); title.style.fontWeight='600'; title.style.marginBottom='6px'; title.textContent='Data Activity Overview';
      var body = document.createElement('div'); body.id='dataRollupBody'; body.className='muted'; body.textContent='Loading…';
      card.appendChild(title); card.appendChild(body); sec.appendChild(card);
      var header = document.querySelector('.header');
      if(header && header.parentNode){ header.parentNode.insertBefore(sec, header.nextSibling); }
    }
    async function load(){
      var body = document.getElementById('dataRollupBody'); var sec = document.getElementById('dataRollupPanel');
      try {
        const r = await fetch('/api/v1/data/summary', { headers: authHeaders() });
        if(!r.ok) throw new Error('status '+r.status);
        const j = await r.json();
        const c = j.counts || {};
        const lines = [
          'Ingested: '+(c.ingest_total||0),
          'PII queries: '+(c.pii_query||0),
          'Large result sets: '+(c.large_result_set||0),
          'Unusual sinks: '+(c.unusual_sink||0)
        ];
        body.textContent = lines.join('\n'); body.style.whiteSpace='pre';
        sec.style.display = 'block';
      } catch(e){ /*silent*/ }
    }
    load();
  } catch(e){}
})();
</script>
<script>
async function _loadMiniFlags(){
  const el = document.getElementById('idMiniFlags'); if(!el) return;
  try{
    const h = authHeaders(); try{ const ak = localStorage.getItem('adminKey')||''; if(ak) h['x-admin-key']=ak; }catch(_){ }
    const r = await fetch('/api/v1/admin/flags', { headers: h });
    if(!r.ok){ el.style.display='none'; return; }
    const j = await r.json(); const eff=j.effective||{}; const ov=j.overrides||{};
    const ml = (ov.ENABLE_ISO_ML ?? eff.ENABLE_ISO_ML) ? 'on' : 'off';
    const tp = (ov.ENABLE_LS_TEMPORAL ?? eff.ENABLE_LS_TEMPORAL) ? 'on' : 'off';
    el.textContent = ML:  • Temporal: ; el.style.display='block';
  }catch(_){ el.style.display='none'; }
}
try{ _loadMiniFlags(); }catch(_){ }
</script>
</html>

