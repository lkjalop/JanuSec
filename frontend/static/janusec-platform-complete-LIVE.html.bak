        <!-- Main Content Area -->
        <main class="main-content" id="mainContent">
            <div class="content-header">
                <h1 class="content-title">Security Operations Dashboard</h1>
                <div class="action-bar">
                    <button class="btn" onclick="refreshData()"><span class="ico ico-refresh"></span>Refresh</button>
                    <button class="btn btn-primary" onclick="showUploadZone()"><span class="ico ico-upload"></span>Upload Logs</button>
                </div>
            </div>

            <div class="dashboard-grid">
                <!-- Upload Zone (hidden by default) -->
                <div class="upload-zone" id="uploadZone" style="display: none;">
                    <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="margin: 0 auto 16px; opacity: 0.5;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                    </svg>
                    <div style="color: var(--text-primary); font-weight: 500; margin-bottom: 8px;">Drop log files here</div>
                    <div style="color: var(--text-muted); font-size: 13px;">Supports PCAP, EVTX, JSON, CSV, and Excel (XLS/XLSX/XLSM/ODS; ZIP/GZ compressed)</div>
                    <div id="uploadParseBadge" style="position:absolute; top:8px; right:8px; display:none; background:var(--accent); color:#fff; font-size:11px; padding:4px 8px; border-radius:12px;">0 rows</div>
                    <input type="file" id="fileInput" style="display: none;" multiple accept=".pcap,.evtx,.json,.csv,.log,.xls,.xlsx,.xlsm,.ods,.zip,.gz">
                </div>

                <!-- Metrics Cards -->
                <div class="metrics-row">
                    <div class="metric-card">
                        <div class="metric-value" style="color: var(--critical);">2</div>
                        <div class="metric-label">Critical Threats</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-value">342</div>
                        <div class="metric-label">Artifacts Analyzed</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-value" style="color: var(--safe);">98.2%</div>
                        <div class="metric-label">Detection Rate</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-value">1.2s</div>
                        <div class="metric-label">Avg Response Time</div>
                    </div>
                    <div class="metric-card" id="temporalMetricCard">
                        <div class="metric-value" id="temporalAvg">0.000</div>
                        <div class="metric-label">Temporal Avg Score</div>
                    </div>
                </div>

                <!-- LM Detection Mini Cards -->
                <div class="metrics-row" id="lmRow">
                    <div class="metric-card">
                        <div class="metric-value" id="lmCandidates">0</div>
                        <div class="metric-label">LM Candidates</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-value" id="lmComposites">0</div>
                        <div class="metric-label">LM Composites</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-value" id="lmPrecision">0.00</div>
                        <div class="metric-label">LM Precision (proxy)</div>
                    </div>
                </div>
                <!-- Predictive LM Risk -->
                <div class="metrics-row" id="predRow">
                    <div class="metric-card">
                        <div class="metric-value" id="predLmAvg">0.00</div>
                        <div class="metric-label">Predictive LM Risk (avg)</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-value" id="predLmCount">0</div>
                        <div class="metric-label">Entities Scored</div>
                    </div>
                </div>
                <!-- Cloud Posture Risk -->
                <div class="metrics-row" id="postureRow">
                    <div class="metric-card">
                        <div class="metric-value" id="postureTotal">0</div>
                        <div class="metric-label">Cloud Posture Findings</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-value" id="postureHigh">0</div>
                        <div class="metric-label">High/Critical Findings</div>
                    </div>
                </div>

                <!-- Real-time Chart -->
                <div class="chart-container">
                    <h3 style="margin-bottom: 16px; font-size: 14px; font-weight: 600;">Threat Detection Timeline</h3>
                    <canvas id="threatChart"></canvas>
                </div>

                <!-- Alert Feed -->
                <div class="alert-feed">
                    <h3 style="margin-bottom: 16px; font-size: 14px; font-weight: 600;">Recent Alerts</h3>
                    <div id="alertFeed">
                        <div class="alert-item">
                            <div class="alert-severity critical"></div>
                            <div class="alert-content">
                                <div class="alert-title">Ransomware Behavior Detected - powerscan.exe</div>
                                <div class="alert-meta">MITRE: T1486 • 4 hosts affected • 2 minutes ago</div>
                            </div>
                        </div>
                        <div class="alert-item">
                            <div class="alert-severity high"></div>
                            <div class="alert-content">
                                <div class="alert-title">Suspicious Macro Execution - macro_payload.dotm</div>
                                <div class="alert-meta">MITRE: T1566 • 2 hosts affected • 15 minutes ago</div>
                            </div>
                        </div>
                        <div class="alert-item">
                            <div class="alert-severity critical"></div>
                            <div class="alert-content">
                                <div class="alert-title">C2 Communication Pattern Identified</div>
                                <div class="alert-meta">MITRE: T1071 • Network beacon detected • 18 minutes ago</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- Right Panel (Investigation/Details) -->
        <aside class="right-panel" id="rightPanel">
            <div class="panel-header">
                <h3 style="font-size: 16px; font-weight: 600;">Investigation Console</h3>
                <button class="detach-btn" onclick="toggleDetachPanel()" title="Detach Panel"><span class="ico ico-detach" aria-hidden="true"></span></button>
            </div>

            <!-- Integration Panel -->
            <div class="integration-panel">
                <div class="integration-header">Quick Integrations</div>
                <div class="integration-grid">
                    <button class="integration-btn connected" onclick="toggleIntegration('xdr')"><span class="ico ico-xdr" aria-hidden="true"></span>XDR</button>
                    <button class="integration-btn" onclick="toggleIntegration('zeek')"><span class="ico ico-zeek" aria-hidden="true"></span>ZEEK</button>
                    <button class="integration-btn" onclick="toggleIntegration('slack')"><span class="ico ico-slack" aria-hidden="true"></span>Slack</button>
                    <button class="integration-btn" onclick="toggleIntegration('teams')"><span class="ico ico-teams" aria-hidden="true"></span>Teams</button>
                    <button class="integration-btn" onclick="toggleIntegration('whatsapp')"><span class="ico ico-whatsapp" aria-hidden="true"></span>WhatsApp</button>
                </div>
            </div>

            <!-- Active Investigation (live-wired) -->
