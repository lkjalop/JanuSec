                    // metrics logic extracted to /static/js/metrics.js
                    // Kept the stub here for backward compatibility; full implementation now lives in /static/js/metrics.js

                if (response.ok) {
                    showNotification(`Analysis complete! Processed ${result.files_processed} files - ${result.total_threats_detected} threats detected`);
                    // Refresh metrics after upload
                    setTimeout(updateMetrics, 1000);
                } else {
                    throw new Error(result.detail || 'Upload failed');
                }
            } catch (error) {
                console.error('File upload failed:', error);
                showNotification(`Upload failed: ${error.message}`);
            }
        }
        
        // Integration toggles
        async function toggleIntegration(service, el) {
            const btn = el || event.target.closest('.integration-btn');
            const shouldEnable = !btn.classList.contains('connected');
            try {
                const r = await fetch(`/api/v1/integrations/${service}/toggle?enabled=${shouldEnable}`, { method: 'POST', headers: { ...authHeaders() } });
                const data = await r.json();
                if (!r.ok || data.error) throw new Error(data.error || 'toggle_failed');
                btn.classList.toggle('connected', shouldEnable);
                showNotification(`${service.toUpperCase()} ${shouldEnable ? 'connected' : 'disconnected'}`);
                // Optionally send a webhook test for chat services when enabling
                if (shouldEnable && (service === 'slack' || service === 'teams' || service === 'whatsapp')) {
                    try{
                        const wr = await fetch('/api/v1/webhooks/test', { method: 'POST', headers: { 'Content-Type': 'application/json', ...authHeaders() }, body: JSON.stringify({ service }) });
                        let wj = {};
                        try{ wj = await wr.json().catch(()=>({})); }catch(_){}
                        if (!wr.ok) {
                            const det = (wj && (wj.detail || wj.error)) ? (wj.detail || wj.error) : ('HTTP ' + wr.status);
                            showNotification(`Webhook test failed: ${det}`, 'error');
                        } else if (wj.delivered) {
                            showNotification(`${service} webhook test delivered`, 'success');
                        } else {
                            showNotification(`${service} webhook not configured${wj.error ? ': ' + wj.error : ''}`);
                        }
                    }catch(e){ console.error(e); showNotification(`Webhook test failed: ${e.message||e}`,'error'); }
                }
            } catch (e) {
                console.error(e);
                showNotification(`Failed to toggle ${service}: ${e.message}`);
            }
        }
        
        // View switching
        function switchView(view, sourceEl) {
            if(!view) return;
            document.querySelectorAll('.sidebar .nav-item[data-view]').forEach(i=>i.classList.remove('active','aria-current'));
            if(sourceEl){ sourceEl.classList.add('active'); sourceEl.setAttribute('aria-current','page'); }
            const contentTitle = document.querySelector('.content-title');
            if(contentTitle) contentTitle.textContent = view.charAt(0).toUpperCase()+view.slice(1);
            showNotification('Switched to '+view+' view');
        }

        // Detach / attach right panel
        let panelDetached = false; let detachedWindow = null;
        function toggleDetachPanel(){
            const panel = document.getElementById('rightPanel');
            if(!panel) return;
            if(!panelDetached){
                const w = window.open('', 'investigation_panel', 'width=480,height=800');
                if(!w){ showNotification('Popup blocked','error'); return; }
                detachedWindow = w;
                w.document.write('<html><head><title>Investigation Console</title><base href="'+location.origin+'" /></head><body style="margin:0;font-family:Inter,Segoe UI,sans-serif;background:#0B0E14;color:#E8EBF0;">'+panel.innerHTML+'</body></html>');
                panel.style.display='none';
                panelDetached = true;
                showNotification('Panel detached','info');
                const timer = setInterval(()=>{ if(w.closed){ clearInterval(timer); reattachPanel(); } }, 1000);
            } else {
                reattachPanel();
            }
        }
        function reattachPanel(){
            const panel = document.getElementById('rightPanel');
            if(!panel) return;
            panel.style.display='block';
            panelDetached=false;
            if(detachedWindow && !detachedWindow.closed) detachedWindow.close();
            detachedWindow=null;
            showNotification('Panel reattached','info');
        }
        
        // Notifications: load shared utility if not already loaded
        (function ensureNotifications(){ if(!window.notifications){ const s=document.createElement('script'); s.src='/static/js/notifications.js'; document.head.appendChild(s); } })();

    // Load shared tabular helpers
    (function ensureParseHelpers(){ if(!window.parseTabular){ const s=document.createElement('script'); s.src='/static/js/parse_tabular.js'; document.head.appendChild(s); } })();

    // Auth probe banner helper (creates a persistent top banner with demo-key actions)
    function showAuthBanner(opts){
        try{
            opts = opts || {};
            let b = document.getElementById('authProbeBanner');
            if(!b){
                b = document.createElement('div');
                b.id = 'authProbeBanner';
                b.style.cssText = 'width:100%;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 14px;background:var(--bg-tertiary);border-bottom:1px solid var(--border);z-index:9999';
                const left = document.createElement('div'); left.id = 'authProbeBannerMsg'; left.style.color = 'var(--text-muted)'; b.appendChild(left);
                const right = document.createElement('div'); right.style.display='flex'; right.style.gap='8px';
                const copyBtn = document.createElement('button'); copyBtn.className='btn'; copyBtn.textContent='Copy demo key';
                copyBtn.onclick = async function(){ try{ await navigator.clipboard.writeText('devkey123'); if(window.showNotification) showNotification('Demo key copied to clipboard','success'); else showNotification && showNotification('Demo key copied to clipboard'); }catch(e){ showNotification && showNotification('Copy failed','error'); } };
                const setBtn = document.createElement('button'); setBtn.className='btn btn-primary'; setBtn.textContent='Use demo key';
                setBtn.onclick = function(){ try{ localStorage.setItem('apiKey','devkey123'); if(window.showNotification) showNotification('Demo API key set Ã¢â‚¬â€ reloading','info'); setTimeout(()=> location.reload(), 500); }catch(e){ showNotification && showNotification('Failed to set demo key','error'); } };
                right.appendChild(copyBtn); right.appendChild(setBtn);
                b.appendChild(right);
                document.body.insertBefore(b, document.body.firstChild);
            }
            const msgEl = document.getElementById('authProbeBannerMsg');
            if(msgEl) msgEl.textContent = opts.message || 'Backend authentication issue or backend unreachable. Use the demo key to continue.';
            b.style.display = 'flex';
        }catch(e){ console.warn('showAuthBanner failed', e); }
    }

    // ---- Upload Zone wiring (now using shared parseTabular helpers) ----
        (function initUpload(){
            const zone=document.getElementById('uploadZone'); const input=document.getElementById('fileInput'); if(!zone || !input) return;
            const badge=document.getElementById('uploadParseBadge');
            function prevent(e){ e.preventDefault(); e.stopPropagation(); }
            ['dragenter','dragover','dragleave','drop'].forEach(ev=> zone.addEventListener(ev, prevent));
            ['dragenter','dragover'].forEach(ev=> zone.addEventListener(ev, ()=> zone.classList.add('dragover')));
            ['dragleave','drop'].forEach(ev=> zone.addEventListener(ev, ()=> zone.classList.remove('dragover')));
            zone.addEventListener('click', ()=> input.click());
            zone.addEventListener('drop', async (e)=>{ const files=e.dataTransfer.files; await handleSelectedFiles(files); });
            input.addEventListener('change', async ()=>{ await handleSelectedFiles(input.files); input.value=''; });
            window.showUploadZone = function(){ if(zone.style.display==='none'){ zone.style.display='block'; zone.scrollIntoView({behavior:'smooth'}); } else { zone.style.display='none'; } };
            async function handleSelectedFiles(fileList){ if(!fileList || !fileList.length){ showNotification('No files selected'); return; } showNotification('Processing '+fileList.length+' file(s)...'); const client = await parseTabular.clientSideAggregate(Array.from(fileList)); if(client.status.length) console.log('[upload-status]', client.status); if(client.errors.length) client.errors.forEach(e=> console.warn('[upload-error]', e)); if(client.rows.length){ const summary=parseTabular.summarizeParsed(client.rows); showNotification(summary); if(badge){ badge.textContent = client.rows.length + ' rows'; badge.style.display='block'; } } // always attempt server upload for full parsing / ingestion
                try {
                    const fd=new FormData(); Array.from(fileList).forEach(f=> fd.append('files', f, f.name));
                    const resp = await fetch('/api/v1/upload/files', { method:'POST', headers:{ ...authHeaders() }, body: fd });
                    let json = {};
                    try{ json = await resp.clone().json().catch(()=>({})); }catch(_){}
                    if(!resp.ok){
                        // Prefer JSON detail when available
                        const detail = (json && (json.detail || json.error)) ? (json.detail || json.error) : await resp.text().catch(()=>'');
                        // Show explicit toast with status and details
                        try{ showNotification(`Upload failed: HTTP ${resp.status} ${detail}`,'error'); }catch(_){ }
                        // If auth error, show persistent auth banner with actions
                        if(resp.status === 401 || resp.status === 403){ try{ showAuthBanner({ message: 'Upload unauthorized (401/403). Set or copy demo API key.' }); }catch(_){} }
                        throw new Error(`Server upload failed ${resp.status} ${detail}`);
                    }
                    try{ json = await resp.json().catch(()=>({})); }catch(_){ json = {} }
                    // If server returns session ids for tabular ingestion, persist them and show quick link
                    try{
                        if(json && json.sessions){ // expect array
                            const sess = Array.isArray(json.sessions) ? json.sessions : [json.sessions];
                            try{ localStorage.setItem('lastTabularSessions', JSON.stringify(sess)); }catch(_){ }
                            // show a small session badge near Upload area and Executive Links
                            const execCard = document.getElementById('execLinkCard');
                            if(execCard){ execCard.style.display='block'; execCard.innerHTML = `<div class="row" style="justify-content:space-between; align-items:center"><div class="title">Executive Report</div><div class="muted">Sessions: ${sess.map(s=>`<span class="pill">${_htmlEsc(s)}</span>`).join(' ')}</div></div><div class="row" style="gap:8px; margin-top:8px"><a class="btn primary" target="_blank" href="/api/v1/report/ingestion?format=html&include_model=true&include_scenarios=true&sessions=${encodeURIComponent(sess.join(','))}">Open Executive (this upload)</a></div>`; }
                        }
                    }catch(_){ }
                    try{ showNotification('Server ingestion complete','success'); }catch(_){ }
                    console.log('Server upload result', json);
                    setTimeout(()=>{ try{ updateMetrics && updateMetrics(); }catch(_){} }, 1200);
                } catch(e){ showNotification('Upload failed: '+(e.message||e),'error'); }
            }
        })();

        
        // Update metrics with REAL API data
        // (duplicate openInvestigationDetails removed; see /static/js/investigation.js)
                        const el = document.getElementById('aiStatus');
                        if (el) {
                            const conn = ai && ai.connected;
                            el.textContent = 'AI: ' + (conn ? 'ready' : 'off');
                            el.className = 'pill-badge ' + (conn ? 'pill-ok' : 'pill-err');
                        }
                    }
                } catch (_) {}

                // Update FinOps badge using overview anomaly flag
                try {
                    const fr = await fetch('/api/v1/finops/overview', { headers: { ...authHeaders() } });
                    if (fr.ok) {
                        const fj = await fr.json();
                        const el = document.getElementById('finopsStatus');
                        if (el) {
                            const anom = !!fj.anomaly_flag;
                            el.textContent = 'FinOps: ' + (anom ? 'anomaly' : 'normal');
                            el.className = 'pill-badge ' + (anom ? 'pill-warn' : 'pill-ok');
                        }
                    }
                } catch (_) {}

                // Active Investigation (live)
                try {
                    const invR = await fetch('/api/v1/dashboard/investigation/active');
                    if (invR.ok) {
                        const inv = await invR.json();
                        const el = document.getElementById('investigationPanel');
                        if (el) {
                            const title = inv && inv.target ? `Active Investigation: ${inv.target}` : 'Active Investigation';
                            const sha = inv && inv.sha256 ? inv.sha256 : 'n/a';
                            const first = inv && inv.first_seen ? inv.first_seen : 'n/a';
                            const hosts = Array.isArray(inv && inv.affected_hosts) ? inv.affected_hosts.join(', ') : 'n/a';
                            const sev = inv && inv.severity ? inv.severity : 'n/a';
                            const conf = inv && typeof inv.confidence === 'number' ? inv.confidence.toFixed(2) : 'n/a';
                            el.innerHTML = `
                                <div class=\"section-title\">${title}</div>
                                <div class=\"evidence-list\">
                                    <div class=\"evidence-item\">SHA256: ${sha}</div>
                                    <div class=\"evidence-item\">First Seen: ${first}</div>
                                    <div class=\"evidence-item\">Affected Hosts: ${hosts}</div>
                                    <div class=\"evidence-item\">Severity: ${sev} ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¢ Confidence: ${conf}</div>
                                </div>`;
                        }
                    }
                } catch(_) {}

                // Incident enrichment (framework + beacon explanation from recent incident if present)
                try {
                    const ir = await fetch('/api/v1/incidents?limit=1', { headers: authHeaders() });
                    if (ir.ok) {
                        const ij = await ir.json();
                        const inc = (ij && (ij.incidents || ij.rows || ij.data || []))[0];
                        if (inc) {
                            // Framework enrichment mapping
                            const fe = inc.framework_enrichment;
                            const feNode = document.getElementById('frameworkEnrichmentContent');
                            if (feNode && fe && typeof fe === 'object') {
                                const rows = [];
                                try {
                                    for (const [factor, fw] of Object.entries(fe)) {
                                        if (!fw) continue;
                                        const parts = [];
                                        for (const [k,v] of Object.entries(fw)) {
                                            if (Array.isArray(v) && v.length) parts.push(`${k}: ${v.slice(0,6).join(',')}`);
                                        }
                                        rows.push(`<div><span style='color:var(--accent);'>${factor}</span> Ã¢â€ â€™ ${parts.join(' | ')}</div>`);
                                    }
                                } catch(_) {}
                                if (rows.length) { 
                                    feNode.innerHTML = rows.slice(0,25).join('');
                                    window._lastFrameworkEnrichment = fe;
                                    window._lastFrameworkIncident = inc;
                                    try {
                                        feNode.querySelectorAll('span').forEach(s => {
                                            s.classList.add('factor-token');
                                            s.addEventListener('click', () => openFactorDrilldown(s.textContent));
                                        });
                                    } catch(_){}
                                }
                            }
                            // Beacon explanation (if any event carried it and was surfaced in incident details)
                            const bx = inc.beacon_explain || (inc.explanations && inc.explanations.beacon_explain);
                            if (bx) {
                                const panel = document.getElementById('beaconExplainPanel');
                                const content = document.getElementById('beaconExplainContent');
                                if (panel && content) {
                                    panel.style.display = 'block';
                                    try {
                                        const lines = [];
                                        for (const [k,v] of Object.entries(bx)) {
                                            lines.push(`${k}: ${v}`);
                                        }
                                        content.textContent = lines.join('\n');
                                    } catch(_) { content.textContent = JSON.stringify(bx); }
                                }
                            }
                        }
                    }
                } catch(_) { /* ignore */ }

                // Try to populate alert feed from recent decisions (requires api key)
                try {
                    const recents = await fetch('/api/v1/decisions/recent?limit=15', { headers: authHeaders() });
                    if (recents.ok) {
                        const j = await recents.json();
                        const container = document.getElementById('alertFeed');
                        const rows = (j.rows || j.events || []);
                        if (container && Array.isArray(rows)) {
                            container.innerHTML = rows.map(r => {
                                const ev = r.event_id || r.id || 'unknown';
                                const verdict = (r.verdict || '').toLowerCase();
                                const sev = verdict === 'malicious' || verdict === 'block' ? 'critical' : (verdict === 'suspicious' || verdict === 'escalate' ? 'high' : 'medium');
                                const title = r.title || r.process_name || r.filename || ev;
                                return `
                                    <div class=\"alert-item\" data-event-id=\"${ev}\" title=\"Click for details\">
                                        <div class=\"alert-severity ${sev}\"></div>
                                        <div class=\"alert-content\">
                                            <div class=\"alert-title\">${title}</div>
                                            <div class=\"alert-meta\">verdict: ${verdict} ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¢ id: ${ev}</div>
                                        </div>
                                    </div>`;
                            }).join('');
                            try {
                                // Add explicit Details button to each alert row
                                document.querySelectorAll('#alertFeed .alert-item').forEach(it => {
                                    if (!it.querySelector('.alert-details-btn')) {
                                        const evId = it.getAttribute('data-event-id');
                                        const btn = document.createElement('button');
                                        btn.className = 'icon-btn alert-details-btn';
                                        btn.title = 'Open details';
                                        if (evId) btn.setAttribute('data-event-id', evId);
                                        btn.innerHTML = '\n                                            <span class="ico ico-info" aria-hidden="true"></span>Details\n                                        ';
                                        const host = it.querySelector('.alert-content');
                                        if (host) host.appendChild(btn);
                                    }
                                });
                            } catch (_) {}
                        }
                    }
                } catch(_) { /* ignore if not authorized */ }
            } catch (error) {
                console.error('Failed to update metrics:', error);
                // Fallback to demo data
                document.getElementById('criticalCount').textContent = Math.floor(Math.random() * 5) + 1;
                document.getElementById('highCount').textContent = Math.floor(Math.random() * 15) + 5;
                document.getElementById('mediumCount').textContent = Math.floor(Math.random() * 30) + 10;
                document.getElementById('lastUpdate').textContent = 'Just now';
            }
        }
        
        // Refresh data helper (interval scheduling moved to metrics.js)

    // Tenant temporal load button wiring
    try{
        const tenantBtn = document.getElementById('btnLoadTenant');
        if(tenantBtn){ tenantBtn.addEventListener('click', async function(){
            const tenant = (document.getElementById('tenantInput')||{}).value || '';
            try{
                const q = tenant ? ('?tenant_id='+encodeURIComponent(tenant)) : '';
                const r = await fetch('/api/v1/metrics/temporal'+q, { headers: authHeaders() });
                if(!r.ok){ const txt = await r.text().catch(()=>r.statusText); showNotification('Failed to load tenant temporal: HTTP '+r.status+' '+txt,'error'); return; }
                const j = await r.json().catch(()=>({}));
                // Expect {series: [{entity, values:[{t,v},...] }, ...], summary: {...} }
                const canvas = document.getElementById('temporalSparkCanvas');
                if(!canvas){ // create a small sparkline under the metric
                    const card = document.getElementById('temporalMetricCard');
                    const c = document.createElement('canvas'); c.id='temporalSparkCanvas'; c.className='temporal-spark'; c.width=220; c.height=40; c.style.marginTop='8px'; card.appendChild(c);
                }
                const dataSeries = (j.series && j.series[0] && j.series[0].values) ? j.series[0].values.map(p=>p.v) : (j.values || []);
                if(window.drawTemporalSparkline){ window.drawTemporalSparkline(dataSeries); }
                try{ if(typeof window._setTenantLabel === 'function') window._setTenantLabel(tenant); }catch(_){ }
                // test hook: mark temporal ready for deterministic waits
                try{ const c = document.querySelector('canvas.temporal-spark'); if(c){ c.setAttribute('data-drawn','1'); const ev = new Event('temporal-drawn'); window.__temporalDrawn = true; window.dispatchEvent(ev); } }catch(_){ }
                showNotification('Loaded tenant temporal data','success');
            }catch(e){ console.error(e); showNotification('Failed to load tenant temporal: '+(e.message||e),'error'); }
        }); }
    }catch(e){ console.warn('tenant wiring failed', e); }

    // Admin thresholds panel wiring (dev-only). Uses x-admin-key header if set in localStorage.adminKey
    (function wireAdminPanel(){
        const unlockBtn = document.getElementById('btnUnlockDev');
        const clearKeyBtn = document.getElementById('btnClearAdminKey');
        const panel = document.getElementById('adminTuningPanel');
            function showPanel(show){ panel.style.display = show ? 'block' : 'none'; }
        function hasKey(){ return !!localStorage.getItem('adminKey'); }
        function tryShowPanel(){ showPanel(hasKey()); }
        if(unlockBtn){
            unlockBtn.onclick = function(){
                try{
                    // Non-blocking inline admin key input to avoid alert/prompt blocking in tests
                    if(document.getElementById('adminKeyInlineContainer')){
                        const el = document.getElementById('adminKeyInline'); if(el) el.focus(); return;
                    }
                    const container = document.createElement('div'); container.id = 'adminKeyInlineContainer'; container.style.position='fixed'; container.style.right='18px'; container.style.top='18px'; container.style.zIndex=9999;
                    container.innerHTML = `<div style="background:var(--bg-secondary); padding:10px; border:1px solid var(--border); border-radius:6px; display:flex; gap:8px; align-items:center;">
                        <input id='adminKeyInline' placeholder='Enter admin key' style='padding:6px; border-radius:4px; border:1px solid var(--border); background:transparent; color:var(--text-primary)' />
                        <button id='adminKeySave' class='btn'>Save</button>
                        <button id='adminKeyCancel' class='btn'>Cancel</button>
                    </div>`;
                    document.body.appendChild(container);
                    document.getElementById('adminKeySave').addEventListener('click', ()=>{
                        const k = (document.getElementById('adminKeyInline')||{}).value || '';
                        if(k && k.length > 3){ try{ localStorage.setItem('adminKey', k); showPanel(true); showNotification('Admin key set','success'); }catch(_){ showNotification('Save failed','error'); } }
                        else { showNotification('No key entered','info'); }
                        try{ container.remove(); }catch(_){}
                    });
                    document.getElementById('adminKeyCancel').addEventListener('click', ()=>{ try{ container.remove(); }catch(_){} });
                    const el = document.getElementById('adminKeyInline'); if(el) el.focus();
                }catch(e){
                    // fallback to prompt if DOM fails
                    try{ const key = prompt('Enter admin API key (will be stored in localStorage.adminKey):'); if(key && key.length > 3){ localStorage.setItem('adminKey', key); showPanel(true); showNotification('Admin key set','success'); } else { showNotification('No key entered','info'); } }catch(_){}
                }
            };
        }
        if(clearKeyBtn){
            clearKeyBtn.onclick = function(){ localStorage.removeItem('adminKey'); showPanel(false); showNotification('Admin key cleared','info'); };
        }
        setTimeout(tryShowPanel, 100);
        const loadBtn = document.getElementById('btnLoadThresholds');
        const saveBtn = document.getElementById('btnSaveThresholds');
        const resetBtn = document.getElementById('btnResetThresholds');
        const hdr = function(){ const h = { 'Content-Type':'application/json', ...authHeaders() }; const ak = localStorage.getItem('adminKey'); if(ak) h['x-admin-key'] = ak; return h; };
        async function load(){
            try{
                const r = await fetch('/api/v1/admin/rules', { headers: hdr() });
                if(!r.ok){ showNotification('Failed to load thresholds: HTTP '+r.status,'error'); return; }
                const j = await r.json().catch(()=>({}));
                // Handle numeric zero values correctly (don't treat 0 as falsy)
                try{ const elL = document.getElementById('th_lateral'); if(elL) elL.value = (('lateral_conn_count' in j) ? String(j.lateral_conn_count) : ''); }catch(_){}
                try{ const elS = document.getElementById('th_scan'); if(elS) elS.value = (('rapid_scan_rate' in j) ? String(j.rapid_scan_rate) : ''); }catch(_){}
                try{ const elE = document.getElementById('th_exfil'); if(elE) elE.value = (('exfil_bytes' in j) ? String(j.exfil_bytes) : ''); }catch(_){}
                showNotification('Loaded thresholds');
            }catch(e){ console.error(e); showNotification('Load failed: '+(e.message||e),'error'); }
        }
            async function save(){ try{ if (window.JanuSecModal){ const ok = await JanuSecModal.confirm({ title:'Save Thresholds', message:'Apply updated admin thresholds?', icon:'info', confirmText:'Save'}); if(!ok) return; } const body = { lateral_conn_count: Number(document.getElementById('th_lateral').value) || 0, rapid_scan_rate: Number(document.getElementById('th_scan').value) || 0, exfil_bytes: Number(document.getElementById('th_exfil').value) || 0 }; const r = await fetch('/api/v1/admin/rules', { method:'POST', headers: hdr(), body: JSON.stringify(body) }); if(!r.ok){ const t = await r.text().catch(()=>r.statusText); showNotification('Save failed: HTTP '+r.status+' '+t,'error'); return; } showNotification('Thresholds saved','success'); }catch(e){ console.error(e); showNotification('Save failed: '+(e.message||e),'error'); } }
            async function reset(){ try{ if (window.JanuSecModal){ const ok = await JanuSecModal.confirm({ title:'Reset Thresholds', message:'Reset admin thresholds to defaults?', icon:'danger', confirmText:'Reset'}); if(!ok) return; } const r = await fetch('/api/v1/admin/rules/reset', { method:'POST', headers: hdr() }); if(!r.ok){ showNotification('Reset failed: HTTP '+r.status,'error'); return; } showNotification('Thresholds reset to defaults','success'); await load();
                // Emit deterministic admin-ready marker so tests can wait for reset completion
                try{ let m = document.getElementById('admin_rules_ready'); if(!m){ m = document.createElement('div'); m.id = 'admin_rules_ready'; m.style.display='none'; document.body.appendChild(m); } m.setAttribute('data-ts', String(Date.now())); window.__adminRulesReady = true; window.dispatchEvent(new Event('admin-rules-ready')); }catch(_){ }
            }catch(e){ console.error(e); showNotification('Reset failed: '+(e.message||e),'error'); } }
        if(loadBtn) loadBtn.addEventListener('click', load);
        if(saveBtn) saveBtn.addEventListener('click', save);
        if(resetBtn) resetBtn.addEventListener('click', reset);
    })();

    // Tenant label + clear: show current tenant label when loaded via tenant input
    (function tenantLabelFlow(){
        const card = document.getElementById('temporalMetricCard');
        if(!card) return;
        function setTenantLabel(tid){
            let lbl = document.getElementById('tenantLoadedLabel');
            if(!lbl){ lbl = document.createElement('div'); lbl.id='tenantLoadedLabel'; lbl.style.marginTop='8px'; lbl.style.display='flex'; lbl.style.gap='8px'; lbl.style.alignItems='center'; card.appendChild(lbl); }
            if(!tid){ lbl.innerHTML = ''; lbl.style.display='none'; return; }
            lbl.style.display='flex'; lbl.innerHTML = `<div style="font-size:12px;color:var(--text-muted);">Tenant:</div><div style="font-weight:600;">${_htmlEsc(tid)}</div><button class="btn" id="btnClearTenant">Clear</button>`;
            const clear = document.getElementById('btnClearTenant'); if(clear){ clear.addEventListener('click', ()=>{ setTenantLabel(''); // reload global metrics
                try{ window._temporalSpark && (window._temporalSpark.data = []); updateMetrics && updateMetrics(); showNotification('Cleared tenant view, reverted to global'); }catch(e){} }); }
        }
        // expose setter for tenant load handler
        window._setTenantLabel = setTenantLabel;
    })();

    // Unlock Dev flow: prompt for admin key and reveal admin panel when present
    (function devUnlockFlow(){
        const unlock = document.getElementById('btnUnlockDev');
        const clearBtn = document.getElementById('btnClearAdminKey');
        const panel = document.getElementById('adminTuningPanel');
        function isUnlocked(){ return !!(localStorage.getItem('adminKey') || localStorage.getItem('showDev')); }
        function setVisible(v){ if(panel) panel.style.display = v ? 'block' : 'none'; }
        // initialize visibility
        setVisible(isUnlocked());
                if(unlock){ unlock.addEventListener('click', ()=>{
            try{
                // If already unlocked via adminKey/showDev, don't prompt (prevents blocking prompt in tests)
                if(isUnlocked()){ setVisible(true); showNotification('Dev panel already unlocked'); return; }
                // Non-blocking inline admin key input already implemented above; open it instead of prompt
                const existing = localStorage.getItem('adminKey') || '';
                const containerId = 'adminKeyInlineContainer';
                if(document.getElementById(containerId)){
                    const el = document.getElementById('adminKeyInline'); if(el) el.focus(); return;
                }
                const container = document.createElement('div'); container.id = containerId; container.style.position='fixed'; container.style.right='18px'; container.style.top='18px'; container.style.zIndex=9999;
                container.innerHTML = `<div style="background:var(--bg-secondary); padding:10px; border:1px solid var(--border); border-radius:6px; display:flex; gap:8px; align-items:center;">
                        <input id='adminKeyInline' placeholder='Enter admin key' style='padding:6px; border-radius:4px; border:1px solid var(--border); background:transparent; color:var(--text-primary)' />
                        <button id='adminKeySave' class='btn'>Save</button>
                        <button id='adminKeyCancel' class='btn'>Cancel</button>
                    </div>`;
                document.body.appendChild(container);
                document.getElementById('adminKeySave').addEventListener('click', ()=>{
                    const k = (document.getElementById('adminKeyInline')||{}).value || '';
                    if(k && k.length > 3){ try{ localStorage.setItem('adminKey', k); setVisible(true); showNotification('Admin key set','success'); }catch(_){ showNotification('Save failed','error'); } }
                    else { showNotification('No key entered','info'); }
                    try{ container.remove(); }catch(_){ }
                });
                document.getElementById('adminKeyCancel').addEventListener('click', ()=>{ try{ container.remove(); }catch(_){} });
                const el = document.getElementById('adminKeyInline'); if(el) el.focus();
            }catch(e){ console.warn(e); showNotification('Unlock failed','error'); }
        }); }
        if(clearBtn){ clearBtn.addEventListener('click', ()=>{
            localStorage.removeItem('adminKey'); localStorage.removeItem('showDev'); setVisible(false); showNotification('Cleared admin key / dev toggle');
        }); }
    })();

