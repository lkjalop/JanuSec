                        <div style="font-size: 20px; font-weight: 600; color: var(--accent);">$342</div>
                        <div style="font-size: 11px; color: var(--text-muted);">Detection Costs Today</div>
                    </div>
                    <div style="padding: 12px; background: var(--bg-primary); border-radius: 6px;">
                        <div style="font-size: 20px; font-weight: 600; color: var(--safe);">$8,420</div>
                        <div style="font-size: 11px; color: var(--text-muted);">Prevented Damage</div>
                    </div>
                </div>
            </div>

            <!-- MITRE Techniques & Enrichment -->
            <div class="investigation-section">
                <div class="section-title">MITRE ATT&CK Mapping</div>
                <div style="display: flex; flex-wrap: wrap; gap: 6px;" id="mitreMappingStatic">
                    <span style="padding: 4px 8px; background: var(--bg-primary); border-radius: 4px; font-size: 11px; font-family: monospace;">T1059 - Command Execution</span>
                    <span style="padding: 4px 8px; background: var(--bg-primary); border-radius: 4px; font-size: 11px; font-family: monospace;">T1105 - Remote File Copy</span>
                    <span style="padding: 4px 8px; background: var(--bg-primary); border-radius: 4px; font-size: 11px; font-family: monospace;">T1057 - Process Discovery</span>
                </div>
                <div id="frameworkEnrichment" style="margin-top:10px;">
                    <div style="font-size:12px; color: var(--text-muted); margin-bottom:4px;">Framework Enrichment</div>
                    <div id="frameworkEnrichmentContent" style="display:flex; flex-direction:column; gap:4px; font-size:11px; line-height:1.3;"></div>
                </div>
                <div id="beaconExplainPanel" style="margin-top:12px; display:none;">
                    <div style="font-size:12px; color: var(--text-muted); margin-bottom:4px;">Beacon Explanation</div>
                    <div id="beaconExplainContent" style="font-size:11px; line-height:1.35; background: var(--bg-primary); border:1px solid var(--border); padding:6px; border-radius:6px; white-space:pre-line;"></div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div style="margin-top: auto; padding-top: 20px;">
                <button id="btnCreateIncident" onclick="createIncidentFromRecent()" class="btn btn-primary" style="width: 100%; justify-content: center; margin-bottom: 8px;">
                    Create Security Incident
                </button>
                <button id="btnExportReport" onclick="exportInvestigationReport()" class="btn" style="width: 100%; justify-content: center; margin-bottom: 8px;">
                    Export Investigation Report
                </button>
                <div style="background: var(--bg-primary); border:1px solid var(--border); border-radius:6px; padding:8px; margin-bottom:8px;">
                    <div style="font-size:12px; color: var(--text-muted); margin-bottom:6px;">Executive Snapshots</div>
                    <div style="display:flex; gap:6px;">
                        <select id="snapshotSelect" class="input" style="flex:1; background: var(--bg-secondary); color: var(--text-primary); border:1px solid var(--border); border-radius:6px; padding:6px;">
                            <option value="latest">Latest</option>
                        </select>
                        <button class="btn" onclick="openSelectedSnapshot()">Open</button>
                    </div>
                    <div style="display:flex; gap:6px; margin-top:6px;">
                        <button class="btn" onclick="saveExecutiveSnapshot()" title="Save current Executive Overview as immutable snapshot">Save</button>
                    </div>
                </div>
                <button class="btn" onclick="sendToSiem()" style="width: 100%; justify-content: center;">
                    Send to SIEM
                </button>
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px; margin-top:8px;">
                  <button class="btn" onclick="dispatchToSlack()">Dispatch to Slack</button>
                  <button class="btn" onclick="createJiraForRecent()">Create Jira Ticket</button>
                </div>
            </div>
        </aside>

        <!-- Detached Window -->
        <div class="detached-window" id="detachedWindow">
            <div class="detached-header" id="detachedHeader">
                <span style="font-weight: 600;">Investigation Console</span>
                <button class="detach-btn" onclick="toggleDetachPanel()">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="detached-content" id="detachedContent">
                <!-- Content will be cloned here when detached -->
            </div>
        </div>

        <!-- Investigation Details Modal -->
        <div id="investigationModal" class="modal-overlay" onclick="if(event.target===this) closeInvestigationDetails()">
            <div class="modal-dialog">
                <div class="modal-header">
                    <div class="modal-title">
                        Investigation Details — <span id="invEventId">…</span>
                    </div>
                    // metrics logic extracted to /static/js/metrics.js
                    // Kept the stub here for backward compatibility; full implementation now lives in /static/js/metrics.js

                if (response.ok) {
                    showNotification(`Analysis complete! Processed ${result.files_processed} files - ${result.total_threats_detected} threats detected`);
                    // Refresh metrics after upload
                    setTimeout(updateMetrics, 1000);
                } else {
                    throw new Error(result.detail || 'Upload failed');
                }
            } catch (error) {
                console.error('File upload failed:', error);
                showNotification(`Upload failed: ${error.message}`);
            }
        }
        
        // Integration toggles
        async function toggleIntegration(service, el) {
            const btn = el || event.target.closest('.integration-btn');
            const shouldEnable = !btn.classList.contains('connected');
            try {
                const r = await fetch(`/api/v1/integrations/${service}/toggle?enabled=${shouldEnable}`, { method: 'POST', headers: { ...authHeaders() } });
                const data = await r.json();
                if (!r.ok || data.error) throw new Error(data.error || 'toggle_failed');
                btn.classList.toggle('connected', shouldEnable);
                showNotification(`${service.toUpperCase()} ${shouldEnable ? 'connected' : 'disconnected'}`);
                // Optionally send a webhook test for chat services when enabling
                if (shouldEnable && (service === 'slack' || service === 'teams' || service === 'whatsapp')) {
                    const wr = await fetch('/api/v1/webhooks/test', { method: 'POST', headers: { 'Content-Type': 'application/json', ...authHeaders() }, body: JSON.stringify({ service }) });
                    const wj = await wr.json();
                    if (wj.delivered) {
                        showNotification(`${service} webhook test delivered`, 'success');
                    } else {
                        showNotification(`${service} webhook not configured${wj.error ? ': ' + wj.error : ''}`);
                    }
                }
            } catch (e) {
                console.error(e);
                showNotification(`Failed to toggle ${service}: ${e.message}`);
            }
        }
        
        // View switching
        function switchView(view, sourceEl) {
            if(!view) return;
            document.querySelectorAll('.sidebar .nav-item[data-view]').forEach(i=>i.classList.remove('active','aria-current'));
            if(sourceEl){ sourceEl.classList.add('active'); sourceEl.setAttribute('aria-current','page'); }
            const contentTitle = document.querySelector('.content-title');
            if(contentTitle) contentTitle.textContent = view.charAt(0).toUpperCase()+view.slice(1);
            showNotification('Switched to '+view+' view');
        }

        // Detach / attach right panel
        let panelDetached = false; let detachedWindow = null;
        function toggleDetachPanel(){
            const panel = document.getElementById('rightPanel');
            if(!panel) return;
            if(!panelDetached){
                const w = window.open('', 'investigation_panel', 'width=480,height=800');
                if(!w){ showNotification('Popup blocked','error'); return; }
                detachedWindow = w;
                w.document.write('<html><head><title>Investigation Console</title><base href="'+location.origin+'" /></head><body style="margin:0;font-family:Inter,Segoe UI,sans-serif;background:#0B0E14;color:#E8EBF0;">'+panel.innerHTML+'</body></html>');
                panel.style.display='none';
                panelDetached = true;
                showNotification('Panel detached','info');
                const timer = setInterval(()=>{ if(w.closed){ clearInterval(timer); reattachPanel(); } }, 1000);
            } else {
                reattachPanel();
            }
        }
        function reattachPanel(){
            const panel = document.getElementById('rightPanel');
            if(!panel) return;
            panel.style.display='block';
            panelDetached=false;
            if(detachedWindow && !detachedWindow.closed) detachedWindow.close();
            detachedWindow=null;
            showNotification('Panel reattached','info');
        }
        
        // Notifications: load shared utility if not already loaded
        (function ensureNotifications(){ if(!window.notifications){ const s=document.createElement('script'); s.src='/static/js/notifications.js'; document.head.appendChild(s); } })();

    // Load shared tabular helpers
    (function ensureParseHelpers(){ if(!window.parseTabular){ const s=document.createElement('script'); s.src='/static/js/parse_tabular.js'; document.head.appendChild(s); } })();

    // ---- Upload Zone wiring (now using shared parseTabular helpers) ----
        (function initUpload(){
            const zone=document.getElementById('uploadZone'); const input=document.getElementById('fileInput'); if(!zone || !input) return;
            const badge=document.getElementById('uploadParseBadge');
            function prevent(e){ e.preventDefault(); e.stopPropagation(); }
            ['dragenter','dragover','dragleave','drop'].forEach(ev=> zone.addEventListener(ev, prevent));
            ['dragenter','dragover'].forEach(ev=> zone.addEventListener(ev, ()=> zone.classList.add('dragover')));
            ['dragleave','drop'].forEach(ev=> zone.addEventListener(ev, ()=> zone.classList.remove('dragover')));
            zone.addEventListener('click', ()=> input.click());
            zone.addEventListener('drop', async (e)=>{ const files=e.dataTransfer.files; await handleSelectedFiles(files); });
            input.addEventListener('change', async ()=>{ await handleSelectedFiles(input.files); input.value=''; });
            window.showUploadZone = function(){ if(zone.style.display==='none'){ zone.style.display='block'; zone.scrollIntoView({behavior:'smooth'}); } else { zone.style.display='none'; } };
            async function handleSelectedFiles(fileList){ if(!fileList || !fileList.length){ showNotification('No files selected'); return; } showNotification('Processing '+fileList.length+' file(s)...'); const client = await parseTabular.clientSideAggregate(Array.from(fileList)); if(client.status.length) console.log('[upload-status]', client.status); if(client.errors.length) client.errors.forEach(e=> console.warn('[upload-error]', e)); if(client.rows.length){ const summary=parseTabular.summarizeParsed(client.rows); showNotification(summary); if(badge){ badge.textContent = client.rows.length + ' rows'; badge.style.display='block'; } } // always attempt server upload for full parsing / ingestion
                try { const fd=new FormData(); Array.from(fileList).forEach(f=> fd.append('files', f, f.name)); const resp=await fetch('/api/v1/upload/files',{ method:'POST', headers:{ ...authHeaders() }, body: fd }); if(!resp.ok){ const detail=await resp.text(); throw new Error('Server upload failed '+resp.status+' '+detail); } const json=await resp.json().catch(()=>({}));
                    // If server returns session ids for tabular ingestion, persist them and show quick link
                    try{
                        if(json && json.sessions){ // expect array
                            const sess = Array.isArray(json.sessions) ? json.sessions : [json.sessions];
                            try{ localStorage.setItem('lastTabularSessions', JSON.stringify(sess)); }catch(_){}
                            // show a small session badge near Upload area and Executive Links
                            const execCard = document.getElementById('execLinkCard');
                            if(execCard){ execCard.style.display='block'; execCard.innerHTML = `<div class="row" style="justify-content:space-between; align-items:center"><div class="title">Executive Report</div><div class="muted">Sessions: ${sess.map(s=>`<span class="pill">${_htmlEsc(s)}</span>`).join(' ')}</div></div><div class="row" style="gap:8px; margin-top:8px"><a class="btn primary" target="_blank" href="/api/v1/report/ingestion?format=html&include_model=true&include_scenarios=true&sessions=${encodeURIComponent(sess.join(','))}">Open Executive (this upload)</a></div>`; }
                        }
                    }catch(_){}
                    showNotification('Server ingestion complete','success'); console.log('Server upload result', json); setTimeout(()=>{ try{ updateMetrics && updateMetrics(); }catch(_){} }, 1200);
                } catch(e){ showNotification('Upload failed: '+(e.message||e),'error'); }
            }
        })();

        
        // Update metrics with REAL API data
        // (duplicate openInvestigationDetails removed; see /static/js/investigation.js)
                        const el = document.getElementById('aiStatus');
                        if (el) {
                            const conn = ai && ai.connected;
                            el.textContent = 'AI: ' + (conn ? 'ready' : 'off');
                            el.className = 'pill-badge ' + (conn ? 'pill-ok' : 'pill-err');
                        }
                    }
                } catch (_) {}

                // Update FinOps badge using overview anomaly flag
                try {
                    const fr = await fetch('/api/v1/finops/overview', { headers: { ...authHeaders() } });
                    if (fr.ok) {
                        const fj = await fr.json();
                        const el = document.getElementById('finopsStatus');
                        if (el) {
                            const anom = !!fj.anomaly_flag;
                            el.textContent = 'FinOps: ' + (anom ? 'anomaly' : 'normal');
                            el.className = 'pill-badge ' + (anom ? 'pill-warn' : 'pill-ok');
                        }
                    }
                } catch (_) {}

                // Active Investigation (live)
                try {
                    const invR = await fetch('/api/v1/dashboard/investigation/active');
                    if (invR.ok) {
                        const inv = await invR.json();
                        const el = document.getElementById('investigationPanel');
                        if (el) {
                            const title = inv && inv.target ? `Active Investigation: ${inv.target}` : 'Active Investigation';
                            const sha = inv && inv.sha256 ? inv.sha256 : 'n/a';
                            const first = inv && inv.first_seen ? inv.first_seen : 'n/a';
                            const hosts = Array.isArray(inv && inv.affected_hosts) ? inv.affected_hosts.join(', ') : 'n/a';
                            const sev = inv && inv.severity ? inv.severity : 'n/a';
                            const conf = inv && typeof inv.confidence === 'number' ? inv.confidence.toFixed(2) : 'n/a';
                            el.innerHTML = `
                                <div class=\"section-title\">${title}</div>
                                <div class=\"evidence-list\">
                                    <div class=\"evidence-item\">SHA256: ${sha}</div>
                                    <div class=\"evidence-item\">First Seen: ${first}</div>
                                    <div class=\"evidence-item\">Affected Hosts: ${hosts}</div>
                                    <div class=\"evidence-item\">Severity: ${sev} • Confidence: ${conf}</div>
                                </div>`;
                        }
                    }
                } catch(_) {}

                // Incident enrichment (framework + beacon explanation from recent incident if present)
                try {
                    const ir = await fetch('/api/v1/incidents?limit=1', { headers: authHeaders() });
                    if (ir.ok) {
                        const ij = await ir.json();
                        const inc = (ij && (ij.incidents || ij.rows || ij.data || []))[0];
                        if (inc) {
                            // Framework enrichment mapping
                            const fe = inc.framework_enrichment;
                            const feNode = document.getElementById('frameworkEnrichmentContent');
                            if (feNode && fe && typeof fe === 'object') {
                                const rows = [];
                                try {
                                    for (const [factor, fw] of Object.entries(fe)) {
                                        if (!fw) continue;
                                        const parts = [];
                                        for (const [k,v] of Object.entries(fw)) {
                                            if (Array.isArray(v) && v.length) parts.push(`${k}: ${v.slice(0,6).join(',')}`);
                                        }
                                        rows.push(`<div><span style='color:var(--accent);'>${factor}</span> ? ${parts.join(' | ')}</div>`);
                                    }
                                } catch(_) {}
                                if (rows.length) feNode.innerHTML = rows.slice(0,25).join('');
                            }
                            // Beacon explanation (if any event carried it and was surfaced in incident details)
                            const bx = inc.beacon_explain || (inc.explanations && inc.explanations.beacon_explain);
                            if (bx) {
                                const panel = document.getElementById('beaconExplainPanel');
                                const content = document.getElementById('beaconExplainContent');
                                if (panel && content) {
                                    panel.style.display = 'block';
                                    try {
                                        const lines = [];
                                        for (const [k,v] of Object.entries(bx)) {
                                            lines.push(`${k}: ${v}`);
                                        }
                                        content.textContent = lines.join('\n');
                                    } catch(_) { content.textContent = JSON.stringify(bx); }
                                }
                            }
                        }
                    }
                } catch(_) { /* ignore */ }

                // Try to populate alert feed from recent decisions (requires api key)
                try {
                    const recents = await fetch('/api/v1/decisions/recent?limit=15', { headers: authHeaders() });
                    if (recents.ok) {
                        const j = await recents.json();
                        const container = document.getElementById('alertFeed');
                        const rows = (j.rows || j.events || []);
                        if (container && Array.isArray(rows)) {
                            container.innerHTML = rows.map(r => {
                                const ev = r.event_id || r.id || 'unknown';
                                const verdict = (r.verdict || '').toLowerCase();
                                const sev = verdict === 'malicious' || verdict === 'block' ? 'critical' : (verdict === 'suspicious' || verdict === 'escalate' ? 'high' : 'medium');
                                const title = r.title || r.process_name || r.filename || ev;
                                return `
                                    <div class=\"alert-item\" data-event-id=\"${ev}\" title=\"Click for details\">
                                        <div class=\"alert-severity ${sev}\"></div>
                                        <div class=\"alert-content\">
                                            <div class=\"alert-title\">${title}</div>
                                            <div class=\"alert-meta\">verdict: ${verdict} • id: ${ev}</div>
                                        </div>
                                    </div>`;
                            }).join('');
                            try {
                                // Add explicit Details button to each alert row
                                document.querySelectorAll('#alertFeed .alert-item').forEach(it => {
                                    if (!it.querySelector('.alert-details-btn')) {
                                        const evId = it.getAttribute('data-event-id');
                                        const btn = document.createElement('button');
                                        btn.className = 'icon-btn alert-details-btn';
                                        btn.title = 'Open details';
                                        if (evId) btn.setAttribute('data-event-id', evId);
                                        btn.innerHTML = '\n                                            <span class="ico ico-info" aria-hidden="true"></span>Details\n                                        ';
                                        const host = it.querySelector('.alert-content');
                                        if (host) host.appendChild(btn);
                                    }
                                });
                            } catch (_) {}
                        }
                    }
                } catch(_) { /* ignore if not authorized */ }
            } catch (error) {
                console.error('Failed to update metrics:', error);
                // Fallback to demo data
                document.getElementById('criticalCount').textContent = Math.floor(Math.random() * 5) + 1;
                document.getElementById('highCount').textContent = Math.floor(Math.random() * 15) + 5;
                document.getElementById('mediumCount').textContent = Math.floor(Math.random() * 30) + 10;
                document.getElementById('lastUpdate').textContent = 'Just now';
            }
        }
        
        // Refresh data helper (interval scheduling moved to metrics.js)
        function refreshData() {
            showNotification('Refreshing data...');
            setTimeout(() => { try { updateMetrics(); } catch(_){}; showNotification('Data refreshed successfully'); }, 1000);
        }
        
        // Action buttons and alert click details
        async function createIncidentFromRecent() {
            try {
                const r = await fetch('/api/v1/decisions/recent?limit=1', { headers: authHeaders() });
                const j = r.ok ? await r.json() : null;
                const row = j && (j.rows && j.rows[0] || j.events && j.events[0]);
                const eventId = row ? (row.event_id || row.id) : 'manual';
                const payload = { artifact_id: eventId, title: 'Investigation - escalated from console', severity: 'high' };
                const cr = await fetch('/api/v1/incidents', { method:'POST', headers: { 'Content-Type':'application/json', ...authHeaders() }, body: JSON.stringify(payload) });
                const cj = await cr.json();
                if (cr.ok) {
                    showNotification('Incident created: ' + (cj.incident && cj.incident.id || ''), 'success');
                } else {
                    throw new Error(cj && (cj.detail || cj.error) || 'incident_failed');
                }
            } catch (e) {
                showNotification('Incident create failed: ' + (e.message || e), 'error');
            }
        }
        function exportInvestigationReport() {
            // Prefer using recent tabular session ids (set by CSV Analyzer or other upload flows)
            try {
                let sess = null;
                try { sess = localStorage.getItem('lastTabularSessions'); } catch(_){ sess = null; }
                const qsBase = 'format=html&include_model=true&include_scenarios=true';
                if (sess) {
                    const arr = JSON.parse(sess);
                    if (Array.isArray(arr) && arr.length) {
                        const q = `${qsBase}&sessions=${encodeURIComponent(arr.join(','))}`;
                        window.open(`/api/v1/report/ingestion?${q}`, '_blank');
                        return;
                    }
                }
            } catch(_) {}
            // Fallback: open global report
            window.open('/api/v1/report/ingestion?format=html&include_model=true&include_scenarios=true', '_blank');
        }
        // openInvestigationDetails moved to /static/js/investigation.js
            const btnRpt = document.getElementById('btnExportReport');
            if (btnRpt) btnRpt.addEventListener('click', exportInvestigationReport);
            const feed = document.getElementById('alertFeed');
            if (feed) feed.addEventListener('click', async (ev) => {
                const item = ev.target.closest('.alert-item');
                if (!item) return;
                const id = item.getAttribute('data-event-id');
                if (!id) return;
                openInvestigationDetails(id);
            });
            const invPanel = document.getElementById('investigationPanel');
            if (invPanel) invPanel.addEventListener('click', async () => {
                try {
                    const r = await fetch('/api/v1/decisions/recent?limit=1', { headers: authHeaders() });
                    const j = r.ok ? await r.json() : null;
                    const row = j && (j.rows && j.rows[0] || j.events && j.events[0]);
                    const id = row ? (row.event_id || row.id) : null;
                    if (id) openInvestigationDetails(id); else showNotification('No recent decision available', 'error');
                } catch (e) {
                    showNotification('Failed to open investigation details', 'error');
                }
            });
        }

        // openInvestigationDetails extracted to /static/js/investigation.js
        // See /static/js/investigation.js for the full implementation and helpers

        function closeInvestigationDetails() {
            const overlay = document.getElementById('investigationModal');
            if (overlay) overlay.style.display = 'none';
        }

        async function submitOverride(eventId) {
            try {
                const verdict = (document.getElementById('ovVerdict') || {}).value;
                const confRaw = (document.getElementById('ovConfidence') || {}).value;
                const reason = (document.getElementById('ovReason') || {}).value || undefined;
                const confidence = confRaw ? parseFloat(confRaw) : undefined;
                const r = await fetch(`/api/v1/decisions/${eventId}/override`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json', ...authHeaders() },
                    body: JSON.stringify({ verdict, confidence, reason })
                });
                if (!r.ok) {
                    const j = await r.json().catch(() => ({}));
                    throw new Error(j && (j.detail || j.error) || `override_failed (${r.status})`);
                }
                showNotification('Override applied', 'success');
                // Refresh header pill
                const jr = await r.json().catch(() => ({}));
                const badge = document.getElementById('invVerdictPill');
                if (badge) badge.textContent = `Verdict: ${jr.verdict || verdict} (${jr.confidence ?? confidence ?? '-'})`;
            } catch (e) {
                showNotification('Override failed: ' + (e.message || e), 'error');
            }
        }
        
        // Optional synthetic refresh: prefer live metrics refresh over fake alerts
        setInterval(() => { try { updateMetrics(); } catch(e){} }, 30000);
        
        // Initialize with REAL API connections
    async function initializePlatform() {
            showNotification('JanuSec Platform connecting to backend...', 'info');

            try {
                // Test backend connection
    const healthResponse = await fetch('/health', { headers: { ...authHeaders() } });
                if (!healthResponse.ok) throw new Error('Backend not available');

                // Load initial data
                await updateMetrics();

                // Set up auto-refresh every 30 seconds
                setInterval(updateMetrics, 30000);

                showNotification('JanuSec Platform initialized successfully - all systems connected!', 'success');
            } catch (error) {
                console.error('Backend connection failed:', error);
                showNotification('Backend connection failed - running in demo mode', 'error');

                // Fallback to demo mode
                updateMetrics();
            }
        }

        // NLP Query Panel
        function renderNlpPanel() {
            const rp = document.getElementById('rightPanel');
            const panel = document.createElement('div');
            panel.className = 'investigation-section';
            panel.innerHTML = `
                <div class="section-title">NLP Query</div>
                <div style="display:flex; gap:8px; margin-bottom:8px;">
                    <input id="nlpInput" class="chain-input" placeholder="Ask e.g., 'metrics', 'alerts', 'recent decisions'" style="flex:1;" />
                    <button class="btn" id="nlpBtn">Query</button>
                </div>
                <div class="evidence-item" id="nlpOut">Try asking for metrics or alerts.</div>
            `;
            rp.insertBefore(panel, rp.firstChild);
            document.getElementById('nlpBtn').addEventListener('click', async () => {
                const q = document.getElementById('nlpInput').value || '';
                try {
                    const r = await fetch('/api/v1/query/nlp', { method: 'POST', headers: { 'Content-Type': 'application/json', ...authHeaders() }, body: JSON.stringify({ text: q }) });
                    const j = await r.json();
                    const actions = (j.actions || []).map(a => `${a.method} ${a.path} - ${a.title}`).join('\n');
                    document.getElementById('nlpOut').textContent = `Intent: ${j.intent}\n${actions}`;
                } catch (e) {
                    document.getElementById('nlpOut').textContent = 'NLP query failed: ' + e.message;
                }
            });
        }

    // Start initialization when page loads
        function _boot() { try { renderNlpPanel(); initializePlatform(); attachActionHandlers(); } catch(e) { console.error('init failed', e); } }
        if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', _boot); } else { _boot(); }
        // Extracted scripts are loaded statically below
        // Accessibility & keyboard navigation for sidebar (idempotent)
        (function(){
            const sidebar = document.querySelector('.sidebar');
            if(!sidebar) return;
            const items = Array.from(sidebar.querySelectorAll('.nav-item'));
            function setActive(el){
                items.forEach(i=>{ i.classList.remove('active'); i.removeAttribute('aria-current'); });
                el.classList.add('active');
                el.setAttribute('aria-current','page');
            }
            // Accordion collapse logic
            const sections = Array.from(sidebar.querySelectorAll('.nav-section'));
            sections.forEach(sec => {
                const title = sec.querySelector('.nav-title');
                if(!title) return;
                title.setAttribute('role','button');
                title.setAttribute('tabindex','0');
                title.addEventListener('click', ()=>{ sec.classList.toggle('collapsed'); });
                title.addEventListener('keydown', (e)=>{ if(e.key==='Enter' || e.key===' '){ e.preventDefault(); sec.classList.toggle('collapsed'); } });
            });
            // Auto-collapse if viewport height small
            function autoCollapse(){
                if(window.innerHeight < 800){
                    sections.slice(1).forEach(s=>s.classList.add('collapsed'));
                }
            }
            autoCollapse();
            window.addEventListener('resize', autoCollapse);
            sidebar.addEventListener('click', (e)=>{
                const item = e.target.closest('.nav-item');
                if(!item) return;
                if(item.dataset.view){ e.preventDefault(); setActive(item); switchView(item.dataset.view, item); }
                if(item.dataset.window){ e.preventDefault(); window.open(item.dataset.window,'_blank'); }
            });
            sidebar.addEventListener('keydown', (e)=>{
                const current = document.activeElement.closest('.nav-item');
                const idx = items.indexOf(current);
                if(e.key === 'ArrowDown'){ e.preventDefault(); items[(idx+1+items.length)%items.length].focus(); }
                else if(e.key === 'ArrowUp'){ e.preventDefault(); items[(idx-1+items.length)%items.length].focus(); }
                else if(e.key === 'Home'){ e.preventDefault(); items[0].focus(); }
                else if(e.key === 'End'){ e.preventDefault(); items[items.length-1].focus(); }
                else if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); current && current.click(); }
            });
        })();
    </script>
            <script>
            // Mini metrics updater for CS metrics in header
            (function(){
                function parsePrometheusMetrics(text){
                    const lines = text.split('\n');
                    const metrics = {};
                    for(const l of lines){
                        if(!l || l.startsWith('#')) continue;
                        const parts = l.trim().split(/\s+/);
                        if(parts.length<2) continue;
                        const name = parts[0];
                        const val = parseFloat(parts[1]);
                        metrics[name] = (metrics[name] || 0) + (isNaN(val)?0:val);
                    }
                    return metrics;
                }
                async function updateMiniMetrics(){
                    try{
                        // Try the compact JSON endpoint first
                        const rj = await fetch('/api/v1/metrics/summary');
                        if(rj.ok){
                            const j = await rj.json();
                            const tenant = window.DEFAULT_TENANT || 'default';
                            const t = j[tenant] || j['default'] || {};
                            document.getElementById('cs_dedupe_val') && (document.getElementById('cs_dedupe_val').textContent = (t.dedupe||0).toString());
                            const ups = (t.upserts_success||0) + (t.upserts_failed||0);
                            document.getElementById('cs_upsert_val') && (document.getElementById('cs_upsert_val').textContent = ups.toString());
                            return;
                        }
                    }catch(e){}
                    try{
                        // fallback: scrape prometheus text
                        const r = await fetch('/metrics');
                        if(!r.ok) return;
                        const txt = await r.text();
                        const m = parsePrometheusMetrics(txt);
                        const ded = m['cs_detection_dedupe_total'] || 0;
                        document.getElementById('cs_dedupe_val') && (document.getElementById('cs_dedupe_val').textContent = ded.toString());
                        const up = m['cs_detection_db_upserts_total'] || 0;
                        document.getElementById('cs_upsert_val') && (document.getElementById('cs_upsert_val').textContent = up.toString());
                    }catch(e){}
                }
                setInterval(updateMiniMetrics, 5000);
                updateMiniMetrics();
            })();
            </script>
            <script defer src="/static/js/metrics.js"></script>
            <script defer src="/static/js/investigation.js"></script>
</body>
</html>


