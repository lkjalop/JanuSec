{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "janusec",
      "version": "1.0.0"
    },
    "description": "JanuSec Sentinel Automation Playbook — deploys a Logic App that triggers on Sentinel Incidents and forwards enriched alert data to an Azure Event Hub. JanuSec subscribes to the Event Hub via its Azure Event Hub connector and writes pipeline verdicts back to the incident.",
    "usage": "Deploy per-tenant via: az deployment group create --resource-group <rg> --template-file sentinel_playbook.json --parameters workspaceName=<ws> eventHubNamespace=<ns> eventHubName=janusec-sentinel"
  },
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": { "description": "Sentinel (Log Analytics) workspace name." }
    },
    "playbook_name": {
      "type": "string",
      "defaultValue": "JanuSec-ForwardToEventHub",
      "metadata": { "description": "Logic App (Playbook) name." }
    },
    "eventHubNamespace": {
      "type": "string",
      "metadata": { "description": "Azure Event Hub namespace name." }
    },
    "eventHubName": {
      "type": "string",
      "defaultValue": "janusec-sentinel",
      "metadata": { "description": "Event Hub name inside the namespace." }
    },
    "eventHubConnectionString": {
      "type": "securestring",
      "metadata": { "description": "Event Hub send connection string (SAS policy with Send claim)." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for the Logic App." }
    }
  },
  "variables": {
    "sentinelConnectionName": "[concat('azuresentinel-', parameters('playbook_name'))]",
    "eventHubConnectionName": "[concat('eventhubs-', parameters('playbook_name'))]",
    "logicAppResourceId": "[resourceId('Microsoft.Logic/workflows', parameters('playbook_name'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('sentinelConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Azure Sentinel connection for JanuSec playbook",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('eventHubConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Event Hub connection for JanuSec playbook",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/eventhubs')]"
        },
        "parameterValues": {
          "connectionString": "[parameters('eventHubConnectionString')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('playbook_name')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('eventHubConnectionName'))]"
      ],
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "When_a_response_to_an_Azure_Sentinel_alert_is_triggered": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/subscribe"
              }
            }
          },
          "actions": {
            "Build_JanuSec_payload": {
              "type": "Compose",
              "inputs": {
                "source": "sentinel",
                "incident_id": "@triggerBody()?['WorkspaceSubscriptionId']",
                "incident_name": "@triggerBody()?['AlertDisplayName']",
                "severity": "@triggerBody()?['Severity']",
                "description": "@triggerBody()?['Description']",
                "tactics": "@triggerBody()?['Tactics']",
                "entities": "@triggerBody()?['Entities']",
                "workspace_id": "@triggerBody()?['WorkspaceId']",
                "alert_time": "@triggerBody()?['StartTime']",
                "timestamp": "@utcNow()",
                "janusec_version": "2"
              },
              "runAfter": {}
            },
            "Send_to_Event_Hub": {
              "type": "ApiConnection",
              "inputs": {
                "body": {
                  "ContentData": "@{base64(string(outputs('Build_JanuSec_payload')))}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['eventhubs']['connectionId']"
                  }
                },
                "method": "post",
                "path": "[concat('/@{encodeURIComponent(''', parameters('eventHubName'), ''')}/events')]",
                "queries": {
                  "api-version": "2018-01"
                }
              },
              "runAfter": {
                "Build_JanuSec_payload": ["Succeeded"]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
                "connectionName": "[variables('sentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azuresentinel')]"
              },
              "eventhubs": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('eventHubConnectionName'))]",
                "connectionName": "[variables('eventHubConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/eventhubs')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "playbookResourceId": {
      "type": "string",
      "value": "[variables('logicAppResourceId')]"
    },
    "logicAppPrincipalId": {
      "type": "string",
      "value": "[reference(variables('logicAppResourceId'), '2017-07-01', 'Full').identity.principalId]"
    },
    "instructions": {
      "type": "string",
      "value": "After deployment: 1) Assign the Logic App managed identity the 'Microsoft Sentinel Responder' role on the Sentinel workspace. 2) In Sentinel → Automation, create an Automation Rule that runs this playbook when an Analytics Rule fires. 3) Ensure JanuSec AZURE_EVENT_HUB_CONNECTION_STRING env var points to the same namespace."
    }
  }
}
