[Unit]
Description=Threat Platform Token Rotation Worker
After=network.target

[Service]
Type=simple
User=threat
Group=threat
WorkingDirectory=/opt/threat_platform
ExecStart=/opt/threat_platform/.venv/bin/python -m src.workers.token_rotation
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=APP_DB_DSN=postgresql://user:pass@localhost:5432/threat
Environment=ENABLE_TOKEN_ROTATION=1

[Install]
WantedBy=multi-user.target
