{
  "__inputs": [],
  "__requires": [
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": "9.0.0"},
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0"}
  ],
  "title": "JanuSec Detection Pipeline Overview",
  "uid": "janusec-main",
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Ingest Events per Second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "rate(events_ingested_total[5m])", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Pipeline Stage Latency (ms)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.90, sum by (le,stage) (rate(pipeline_stage_latency_ms_bucket[5m])))", "refId": "A"},
        {"expr": "histogram_quantile(0.50, sum by (le,stage) (rate(pipeline_stage_latency_ms_bucket[5m])))", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Confidence Progression",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.90, sum by (le,stage) (rate(pipeline_confidence_progress_bucket[10m])))", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Parent/Child & Beacon Detections",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "increase(suspicious_parent_child_total[1h])", "refId": "A"},
        {"expr": "increase(beacon_detection_total[1h])", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Rule Hits (Top)",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 15},
      "targets": [
        {"expr": "topk(5, rate(rule_hits_total[10m]))", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Distinct Domain & ASN Counts",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 15},
      "targets": [
        {"expr": "domain_distinct_current", "refId": "A"},
        {"expr": "asn_distinct_current", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Egress & New Domain Factors",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 22},
      "targets": [
        {"expr": "increase(egress_volume_spike_total[30m])", "refId": "A"},
        {"expr": "increase(domain_novelty_total[30m])", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Pipeline Events (Terminal vs Non-Terminal)",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 22},
      "targets": [
        {"expr": "increase(pipeline_events_total{terminal=\"true\"}[30m])", "refId": "A"},
        {"expr": "increase(pipeline_events_total{terminal=\"false\"}[30m])", "refId": "B"}
      ]
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []}
}
