# These files are generated at server startup / runtime and change on every run.
# They must not be tracked — committing them causes constant dirty-tree noise
# and can leak tenant state, session data, and internal metrics to git history.

# Tenant and session runtime state
data/tenants/
data/sessions/
data/file_batches/
data/integrations/
