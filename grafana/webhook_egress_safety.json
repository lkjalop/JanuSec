{
  "title": "Webhook/Egress Safety",
  "editable": true,
  "graphTooltip": 0,
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "type": "stat",
      "title": "SSRF Blocks (total)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(webhook_ssrf_blocks_total)", "legendFormat": "blocked"}]
    },
    {
      "type": "bargauge",
      "title": "SSRF Blocks by Reason (5m rate)",
      "gridPos": {"h": 4, "w": 12, "x": 6, "y": 0},
      "targets": [{"expr": "sum by (reason) (rate(webhook_ssrf_blocks_total[5m]))", "legendFormat": "{{reason}}"}]
    },
    {
      "type": "timeseries",
      "title": "Webhook Error Rate EWMA (by host)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [{"expr": "webhook_error_rate_ewma", "legendFormat": "{{host}}"}]
    },
    {
      "type": "stat",
      "title": "Delivery Success (5m rate)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 12},
      "targets": [{"expr": "sum by (channel) (rate(notifications_sent_total{outcome=\"success\"}[5m]))", "legendFormat": "{{channel}}"}]
    },
    {
      "type": "gauge",
      "title": "Success Ratio (5m)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 12},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [
        {"expr": "sum by (channel) (rate(notifications_sent_total{outcome=\"success\"}[5m])) / sum by (channel) (rate(notifications_sent_total[5m]))", "legendFormat": "{{channel}}"}
      ]
    }
  ]
}
