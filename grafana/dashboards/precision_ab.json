{
  "title": "Precision & AB Tests",
  "uid": "precision-ab",
  "version": 1,
  "timezone": "browser",
  "schemaVersion": 39,
  "tags": ["security", "precision", "ab"],
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "tenant_id",
        "label": "Tenant",
        "datasource": "Prometheus",
        "refresh": 1,
        "query": "label_values(janusec_precision_daily, tenant_id)",
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "test_id",
        "label": "AB Test Id",
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Daily Precision",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "janusec_precision_daily{tenant_id=\"$tenant_id\"}", "legendFormat": "{{day}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Daily Recall",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "janusec_recall_daily{tenant_id=\"$tenant_id\"}", "legendFormat": "{{day}}" }
      ]
    },
    {
      "type": "stat",
      "title": "AB Winner (Last 7d)",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "options": { "reduceOptions": { "calcs": ["last"] } },
      "targets": [
        {
          "expr": "janusec_precision_daily_variant{tenant_id=\"$tenant_id\",test_id=\"$test_id\"}",
          "legendFormat": "{{variant}}"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "AB Variants Precision",
      "gridPos": { "x": 6, "y": 8, "w": 18, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "janusec_precision_daily_variant{tenant_id=\"$tenant_id\",test_id=\"$test_id\"}",
          "legendFormat": "{{variant}} {{day}}"
        }
      ]
    }
  ]
}
